<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep one HTTPS origin so saved routes, canonicals, and browser caches stay consistent.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?budfinder\.org$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.budfinder\.org$ [NC]
  RewriteRule ^ https://budfinder.org%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(self), microphone=(), payment=(), usb=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https:; connect-src 'self' https://router.project-osrm.org; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"

  <FilesMatch "\.(?:html?|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Menu JSON changes in place after every export. Keep it stored locally, but
  # require an ETag/Last-Modified check before reuse so refreshed menus appear
  # immediately without forcing a full re-download when nothing changed.
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.csv$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>

  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  <FilesMatch "\.(?:avif|webp|png|jpe?g|gif|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=31536000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml text/css text/csv text/html text/javascript text/plain
</IfModule>
