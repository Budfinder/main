static bool initializeSpeaker()
{
#ifdef USING_PCM_AMPLIFIER
    static constexpr uint32_t AUDIO_SAMPLE_RATE = 44100;
    if (!instance.initAmplifier()) {
        return false;
    }
    return instance.player.configureTX(
        AUDIO_SAMPLE_RATE,
        I2S_DATA_BIT_WIDTH_16BIT,
        I2S_SLOT_MODE_STEREO);
#else
    return false;
#endif
}

static size_t writeTone(uint16_t frequency, uint16_t durationMs)
{
#ifdef USING_PCM_AMPLIFIER
    static constexpr uint32_t AUDIO_SAMPLE_RATE = 44100;
    // Duplicate every sample into left and right. The MAX98357A board can be
    // strapped to either I2S channel, so this guarantees an audible signal.
    int16_t samples[256 * 2];
    uint32_t remainingFrames =
        static_cast<uint32_t>(durationMs) * AUDIO_SAMPLE_RATE / 1000U;
    size_t totalWritten = 0;
    double phase = 0.0;
    const double step =
        2.0 * M_PI * static_cast<double>(frequency) /
        AUDIO_SAMPLE_RATE;
    while (remainingFrames > 0) {
        const size_t frames =
            remainingFrames < 256U ? remainingFrames : 256U;
        for (size_t index = 0; index < frames; ++index) {
            const int16_t sample =
                static_cast<int16_t>(16000.0 * sin(phase));
            samples[index * 2] = sample;
            samples[index * 2 + 1] = sample;
            phase += step;
            if (phase >= 2.0 * M_PI) {
                phase -= 2.0 * M_PI;
            }
        }
        const size_t wanted = frames * 2 * sizeof(samples[0]);
        const size_t written = instance.player.write(
            reinterpret_cast<uint8_t *>(samples),
            wanted);
        totalWritten += written;
        if (written != wanted) {
            break;
        }
        remainingFrames -= frames;
    }
    return totalWritten;
#else
    (void)frequency;
    (void)durationMs;
    return 0;
#endif
}

static bool startAlertAudio(bool loop)
{
    if (!alertUsesSound()) {
        return false;
    }
    stopAlertAudio();
    if (!speakerReady) {
        speakerReady = initializeSpeaker();
    }
    if (!speakerReady) {
        return false;
    }
    if (alertDecoder == nullptr) {
        alertDecoder = MP3InitDecoder();
    }
    if (alertDecoder == nullptr) {
        Serial.println("BFWatch audio: MP3 decoder allocation failed");
        return false;
    }
    if (alertPcmBuffer == nullptr) {
        const size_t samples =
            MAX_NCHAN * MAX_NGRAN * MAX_NSAMP;
        alertPcmBuffer = static_cast<int16_t *>(
            ps_malloc(samples * sizeof(int16_t)));
    }
    if (alertPcmBuffer == nullptr) {
        MP3FreeDecoder(alertDecoder);
        alertDecoder = nullptr;
        Serial.println("BFWatch audio: PCM PSRAM allocation failed");
        return false;
    }

    alertAudioReadPtr =
        const_cast<uint8_t *>(BFWATCH_ALERT_MP3);
    alertAudioBytesRemaining =
        static_cast<int>(BFWATCH_ALERT_MP3_BYTES);
    alertAudioPlaying = true;
    alertAudioLooping = loop;
    alertAudioRestartMs = 0;
    instance.powerControl(POWER_SPEAK, true);
    delay(75);
    Serial.printf("BFWatch audio: Totaka started at %u%%\n",
                  static_cast<unsigned>(alertVolumePercent));
    setLabel(audioTestButtonLabel, "STOP");
    return true;
}

static void stopAlertAudio()
{
    alertAudioLooping = false;
    alertAudioRestartMs = 0;
    if (alertDecoder != nullptr) {
        MP3FreeDecoder(alertDecoder);
        alertDecoder = nullptr;
    }
    alertAudioReadPtr = nullptr;
    alertAudioBytesRemaining = 0;
    alertAudioPlaying = false;
    delay(5);
    instance.powerControl(POWER_SPEAK, false);
    setLabel(audioTestButtonLabel, "TEST");
}

static void serviceAlertAudio()
{
    if (alertAudioPlaying && alertDecoder != nullptr &&
        alertAudioReadPtr != nullptr &&
        alertAudioBytesRemaining > 0) {
        const int offset = MP3FindSyncWord(
            alertAudioReadPtr, alertAudioBytesRemaining);
        if (offset < 0) {
            alertAudioBytesRemaining = 0;
        } else {
            alertAudioReadPtr += offset;
            alertAudioBytesRemaining -= offset;
            const int error = MP3Decode(
                alertDecoder, &alertAudioReadPtr,
                &alertAudioBytesRemaining,
                alertPcmBuffer, 0);
            if (error == ERR_MP3_NONE) {
                MP3FrameInfo info = {};
                MP3GetLastFrameInfo(alertDecoder, &info);
                if (info.bitsPerSample != 16 ||
                    info.outputSamps <= 0 ||
                    info.outputSamps >
                        MAX_NCHAN * MAX_NGRAN * MAX_NSAMP ||
                    (info.nChans != 1 && info.nChans != 2)) {
                    Serial.println("BFWatch audio: invalid MP3 frame");
                    alertAudioBytesRemaining = 0;
                } else {
                    int outputSamples = info.outputSamps;
                    if (info.nChans == 1) {
                        for (int index = outputSamples - 1;
                             index >= 0; --index) {
                            alertPcmBuffer[index * 2] =
                                alertPcmBuffer[index];
                            alertPcmBuffer[index * 2 + 1] =
                                alertPcmBuffer[index];
                        }
                        outputSamples *= 2;
                    }
                    for (int index = 0;
                         index < outputSamples; ++index) {
                        const int32_t scaled =
                            static_cast<int32_t>(
                                alertPcmBuffer[index]) *
                            alertVolumePercent *
                            ALERT_AUDIO_GAIN_PERCENT / 10000;
                        alertPcmBuffer[index] =
                            static_cast<int16_t>(
                                max(
                                    static_cast<int32_t>(INT16_MIN),
                                    min(
                                        static_cast<int32_t>(INT16_MAX),
                                        scaled)));
                    }
                    if (instance.player.txSampleRate() !=
                            static_cast<uint32_t>(info.samprate) &&
                        !instance.player.configureTX(
                            info.samprate,
                            I2S_DATA_BIT_WIDTH_16BIT,
                            I2S_SLOT_MODE_STEREO)) {
                        Serial.println(
                            "BFWatch audio: sample-rate setup failed");
                        alertAudioBytesRemaining = 0;
                    } else {
                        const size_t wanted =
                            static_cast<size_t>(outputSamples) *
                            sizeof(int16_t);
                        const size_t written = instance.player.write(
                            reinterpret_cast<uint8_t *>(
                                alertPcmBuffer),
                            wanted);
                        if (written != wanted) {
                            Serial.println(
                                "BFWatch audio: PCM write failed");
                            alertAudioBytesRemaining = 0;
                        }
                    }
                }
            } else if (error != ERR_MP3_MAINDATA_UNDERFLOW) {
                Serial.printf(
                    "BFWatch audio: MP3 decode error %d\n", error);
                alertAudioBytesRemaining = 0;
            }
        }
    }

    if (alertAudioPlaying &&
        alertAudioBytesRemaining <= 0) {
        const bool shouldLoop =
            alertAudioLooping && alertRinging;
        if (alertDecoder != nullptr) {
            MP3FreeDecoder(alertDecoder);
            alertDecoder = nullptr;
        }
        alertAudioReadPtr = nullptr;
        alertAudioPlaying = false;
        delay(25);
        instance.powerControl(POWER_SPEAK, false);
        if (shouldLoop) {
            alertAudioRestartMs = millis() + 700U;
        } else {
            alertAudioLooping = false;
            setLabel(audioTestButtonLabel, "TEST");
        }
    }

    if (!alertAudioPlaying && alertAudioLooping &&
        alertRinging && alertAudioRestartMs != 0 &&
        static_cast<int32_t>(millis() - alertAudioRestartMs) >= 0) {
        startAlertAudio(true);
    }
}

static void playAlertPulse()
{
    if (alertUsesVibration()) {
        instance.vibrator();
    }
    if (!alertUsesSound()) {
        return;
    }
    if (startAlertAudio(false)) {
        return;
    }

    // Retain a compact synthesized fallback if MP3 decoding cannot start.
    if (!speakerReady) {
        speakerReady = initializeSpeaker();
    }
    if (!speakerReady) {
        Serial.println("BFWatch audio: amplifier initialization failed");
        return;
    }
    instance.powerControl(POWER_SPEAK, true);
    delay(100);
    const size_t firstWritten = writeTone(880, 120);
    delay(45);
    const size_t secondWritten = writeTone(1175, 150);
    delay(100);
    instance.powerControl(POWER_SPEAK, false);
    const size_t expected =
        (120U + 150U) * 44100U / 1000U *
        2U * sizeof(int16_t);
    Serial.printf(
        "BFWatch audio: wrote=%u/%u error=%d rate=%u\n",
        static_cast<unsigned>(firstWritten + secondWritten),
        static_cast<unsigned>(expected),
        instance.player.lastError(),
        static_cast<unsigned>(instance.player.txSampleRate()));
}

static void startAlert(AlertSource source)
{
    alertSource = source;
    alertRinging = true;
    lastAlertPulseMs = millis();
    if (alertUsesVibration()) {
        instance.vibrator();
    }
    if (alertUsesSound() && !startAlertAudio(true)) {
        playAlertPulse();
    }
    markActivity();
}

static void stopAlert()
{
    alertRinging = false;
    alertSource = AlertSource::NONE;
    lastAlertPulseMs = 0;
    stopAlertAudio();
}

static void serviceAlert()
{
    serviceAlertAudio();
    if (!alertRinging) {
        return;
    }
    const uint32_t now = millis();
    if (alertUsesVibration() &&
        now - lastAlertPulseMs >= ALERT_REPEAT_MS) {
        lastAlertPulseMs = now;
        instance.vibrator();
    }
}

static bool alarmAllowedToday()
{
    struct tm now = {};
    instance.rtc.getDateTime(&now);
    const bool weekend = now.tm_wday == 0 || now.tm_wday == 6;
    if (clockAlarmRepeat == AlarmRepeat::WEEKDAYS) {
        return !weekend;
    }
    if (clockAlarmRepeat == AlarmRepeat::WEEKENDS) {
        return weekend;
    }
    return true;
}

static void configureClockAlarm()
{
    instance.rtc.resetAlarm();
    if (!clockAlarmEnabled) {
        instance.rtc.disableAlarm();
        return;
    }
    instance.rtc.setAlarm(
        clockAlarmHour, clockAlarmMinute, 0xFF, 0xFF);
    instance.rtc.enableAlarm();
    pinMode(RTC_INT, INPUT_PULLUP);
}

static void pollClockAlarm()
{
    if (alarmSnoozeEndsUs > 0 &&
        monotonicUs() >= alarmSnoozeEndsUs) {
        alarmSnoozeEndsUs = 0;
        startAlert(AlertSource::CLOCK);
        currentView = View::ALARM;
        buildCurrentView();
        return;
    }
    if (!clockAlarmEnabled) {
        return;
    }
    const uint32_t nowMs = millis();
    if (nowMs - lastClockAlarmPollMs < 500U) {
        return;
    }
    lastClockAlarmPollMs = nowMs;
    if (!instance.rtc.isAlarmActive()) {
        return;
    }
    instance.rtc.resetAlarm();
    const int64_t nowEpoch = readRtcEpoch();
    if (nowEpoch > 0 &&
        lastClockAlarmEpoch > 0 &&
        nowEpoch - lastClockAlarmEpoch < 60) {
        return;
    }
    lastClockAlarmEpoch = nowEpoch;
    if (!alarmAllowedToday()) {
        return;
    }
    if (clockAlarmRepeat == AlarmRepeat::ONCE) {
        clockAlarmEnabled = false;
        saveSettings();
        instance.rtc.disableAlarm();
    }
    startAlert(AlertSource::CLOCK);
    currentView = View::ALARM;
    buildCurrentView();
}

static const char *cardinalDirection(double degrees)
{
    static const char *const names[] = {
        "N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
        "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"
    };
    int index = static_cast<int>(floor((degrees + 11.25) / 22.5)) & 15;
    return names[index];
}

static double distanceMeters(double lat1, double lon1,
                             double lat2, double lon2)
{
    static constexpr double R = 6371000.0;
    static constexpr double D2R = 0.017453292519943295;
    const double p1 = lat1 * D2R;
    const double p2 = lat2 * D2R;
    const double dp = (lat2 - lat1) * D2R;
    const double dl = (lon2 - lon1) * D2R;
    const double a = sin(dp / 2.0) * sin(dp / 2.0) +
                     cos(p1) * cos(p2) *
                     sin(dl / 2.0) * sin(dl / 2.0);
    return R * 2.0 * atan2(sqrt(a), sqrt(1.0 - a));
}

static double initialBearing(double lat1, double lon1,
                             double lat2, double lon2)
{
    static constexpr double D2R = 0.017453292519943295;
    static constexpr double R2D = 57.29577951308232;
    const double p1 = lat1 * D2R;
    const double p2 = lat2 * D2R;
    const double dl = (lon2 - lon1) * D2R;
    const double y = sin(dl) * cos(p2);
    const double x = cos(p1) * sin(p2) -
                     sin(p1) * cos(p2) * cos(dl);
    double result = atan2(y, x) * R2D;
    if (result < 0.0) {
        result += 360.0;
    }
    return result;
}

static void shopCoordinates(size_t index, double &latitude, double &longitude)
{
    const WatchShopRecord &shop = BFWATCH_SHOPS[index];
    latitude = static_cast<double>(shop.latitudeE6) / 1000000.0;
    longitude = static_cast<double>(shop.longitudeE6) / 1000000.0;
}

static uint32_t shopIdentifierHash(size_t index)
{
    const char *text =
        bfwatchString(BFWATCH_SHOPS[index].identifierOffset);
    uint32_t hash = 2166136261UL;
    while (*text != '\0') {
        hash ^= static_cast<uint8_t>(*text++);
        hash *= 16777619UL;
    }
    return hash;
}

static uint32_t strainNameHash(const char *name)
{
    uint32_t hash = 2166136261UL;
    if (name == nullptr) {
        return hash;
    }
    while (*name != '\0' &&
           isspace(static_cast<unsigned char>(*name))) {
        ++name;
    }
    while (*name != '\0') {
        hash ^= static_cast<uint8_t>(
            tolower(static_cast<unsigned char>(*name++)));
        hash *= 16777619UL;
    }
    return hash;
}

static size_t logoSpriteBytes()
{
    return static_cast<size_t>(BFWATCH_LOGO_WIDTH) *
           BFWATCH_LOGO_HEIGHT * sizeof(lv_color32_t);
}

static bool loadMenuLogoBuffer()
{
    if (menuLogoBufferReady) {
        return true;
    }
    if (!logoPackageReady || logoIndexRecords == nullptr) {
        return false;
    }

    const size_t spriteBytes = logoSpriteBytes();
    const size_t totalBytes =
        static_cast<size_t>(BFWATCH_SHOP_COUNT) * spriteBytes;
    if (menuLogoBuffer == nullptr) {
        menuLogoBuffer = static_cast<uint8_t *>(ps_malloc(totalBytes));
    }
    if (menuLogoBuffer == nullptr) {
        return false;
    }
    memset(menuLogoBuffer, 0, totalBytes);

    File logoData = FFat.open("/logos.bin", FILE_READ);
    if (!logoData) {
        return false;
    }
    for (size_t index = 0; index < BFWATCH_SHOP_COUNT; ++index) {
        const int32_t recordIndex = findLogoRecordIndex(
            shopIdentifierHash(index));
        if (recordIndex < 0) {
            continue;
        }
        const LogoIndexRecord &record = logoIndexRecords[recordIndex];
        uint8_t *destination =
            menuLogoBuffer + index * spriteBytes;
        if (!logoData.seek(record.offset) ||
            logoData.read(destination, spriteBytes) != spriteBytes) {
            memset(destination, 0, spriteBytes);
        }
    }
    logoData.close();
    menuLogoBufferReady = true;
    return true;
}

static uint8_t *menuLogoPixels(size_t index)
{
    if (index >= BFWATCH_SHOP_COUNT || !loadMenuLogoBuffer()) {
        return nullptr;
    }
    return menuLogoBuffer + index * logoSpriteBytes();
}

static bool isShopFavourite(size_t index)
{
    const uint32_t hash = shopIdentifierHash(index);
    for (size_t i = 0; i < favouriteShopCount; ++i) {
        if (favouriteShopHashes[i] == hash) {
            return true;
        }
    }
    return false;
}

static void saveShopPreferences()
{
    Preferences preferences;
    if (!preferences.begin("bfwatch", false)) {
        return;
    }
    preferences.putUChar("favcount",
                         static_cast<uint8_t>(favouriteShopCount));
    if (favouriteShopCount > 0) {
        preferences.putBytes("favshops", favouriteShopHashes,
                             favouriteShopCount * sizeof(uint32_t));
    } else {
        preferences.remove("favshops");
    }
    // Selection was removed in favour of a random watch-face shop.
    preferences.remove("selected");
    preferences.end();
}

static void loadShopPreferences()
{
    Preferences preferences;
    bool haveStoredFavourites = false;
    if (preferences.begin("bfwatch", false)) {
        haveStoredFavourites = preferences.isKey("favcount");
        if (haveStoredFavourites) {
            const size_t requested = preferences.getUChar("favcount", 0);
            const size_t bytes = preferences.getBytesLength("favshops");
            favouriteShopCount =
                min(requested, min(MAX_FAVOURITE_SHOPS,
                                   bytes / sizeof(uint32_t)));
            if (favouriteShopCount > 0) {
                preferences.getBytes(
                    "favshops", favouriteShopHashes,
                    favouriteShopCount * sizeof(uint32_t));
            }
        }
        // Ignore and remove selections saved by earlier firmware versions.
        preferences.remove("selected");
        preferences.end();
    }

    if (!haveStoredFavourites) {
        for (size_t i = 0;
             i < BFWATCH_SHOP_COUNT &&
             favouriteShopCount < MAX_FAVOURITE_SHOPS;
             ++i) {
            if (BFWATCH_SHOPS[i].flags & WATCH_SHOP_FAVOURITE) {
                favouriteShopHashes[favouriteShopCount++] =
                    shopIdentifierHash(i);
            }
        }
        saveShopPreferences();
    }
}

static bool isStrainFavourite(const char *name)
{
    const uint32_t hash = strainNameHash(name);
    for (size_t index = 0; index < favouriteStrainCount; ++index) {
        if (favouriteStrainHashes[index] == hash) {
            return true;
        }
    }
    return false;
}

static void saveStrainPreferences()
{
    Preferences preferences;
    if (!preferences.begin("bfwatch", false)) {
        return;
    }
    preferences.putUChar(
        "favstcount", static_cast<uint8_t>(favouriteStrainCount));
    if (favouriteStrainCount > 0) {
        preferences.putBytes(
            "favstrains", favouriteStrainHashes,
            favouriteStrainCount * sizeof(uint32_t));
    } else {
        preferences.remove("favstrains");
    }
    preferences.end();
}

static void loadStrainPreferences()
{
    Preferences preferences;
    if (!preferences.begin("bfwatch", true)) {
        return;
    }
    const size_t requested =
        preferences.getUChar("favstcount", 0);
    const size_t bytes =
        preferences.getBytesLength("favstrains");
    favouriteStrainCount =
        min(requested, min(
            MAX_FAVOURITE_STRAINS,
            bytes / sizeof(uint32_t)));
    if (favouriteStrainCount > 0) {
        preferences.getBytes(
            "favstrains", favouriteStrainHashes,
            favouriteStrainCount * sizeof(uint32_t));
    }
    preferences.end();
}

static void toggleSelectedStrainFavourite()
{
    if (selectedStrainName[0] == '\0') {
        return;
    }
    const uint32_t hash = strainNameHash(selectedStrainName);
    for (size_t index = 0; index < favouriteStrainCount; ++index) {
        if (favouriteStrainHashes[index] != hash) {
            continue;
        }
        for (size_t next = index + 1;
             next < favouriteStrainCount; ++next) {
            favouriteStrainHashes[next - 1] =
                favouriteStrainHashes[next];
        }
        --favouriteStrainCount;
        saveStrainPreferences();
        return;
    }
    if (favouriteStrainCount < MAX_FAVOURITE_STRAINS) {
        favouriteStrainHashes[favouriteStrainCount++] = hash;
        saveStrainPreferences();
    }
}

static const char *gpsUpdateModeName()
{
    switch (gpsUpdateMode) {
    case GpsUpdateMode::MANUAL:      return "MANUAL";
    case GpsUpdateMode::CONSTANT:    return "CONSTANT";
    case GpsUpdateMode::MINUTES_2_5: return "EVERY 2.5 MIN";
    case GpsUpdateMode::MINUTES_5:   return "EVERY 5 MIN";
    case GpsUpdateMode::AMSTERDAM:   return "AMSTERDAM";
    case GpsUpdateMode::COUNT:       break;
    }
    return "MANUAL";
}

static int64_t gpsUpdateIntervalUs()
{
    switch (gpsUpdateMode) {
    case GpsUpdateMode::CONSTANT:
    case GpsUpdateMode::AMSTERDAM:
        return static_cast<int64_t>(GPS_LIVE_REFRESH_MS) * 1000LL;
    case GpsUpdateMode::MINUTES_2_5:
        return 150LL * 1000000LL;
    case GpsUpdateMode::MINUTES_5:
        return 300LL * 1000000LL;
    case GpsUpdateMode::MANUAL:
    case GpsUpdateMode::COUNT:
        return 0;
    }
    return 0;
}

static bool gpsModeTracksLive()
{
    return gpsUpdateMode == GpsUpdateMode::CONSTANT ||
           gpsUpdateMode == GpsUpdateMode::AMSTERDAM;
}

static bool amsterdamGpsWarmHoldAllowed()
{
    if (gpsUpdateMode != GpsUpdateMode::AMSTERDAM ||
        !gpsAcquiring || gpsManualRequest || !haveFix ||
        !insideAmsterdam(lastLatitude, lastLongitude)) {
        return false;
    }

    const int batteryPercent = instance.pmu.getBatteryPercent();
    return instance.pmu.isVbusIn() || batteryPercent < 0 ||
           batteryPercent >= AMSTERDAM_GPS_MIN_BATTERY_PERCENT;
}

static bool automaticGpsAllowed()
{
    return gpsUpdateMode != GpsUpdateMode::MANUAL &&
           haveFix && insideAmsterdam(lastLatitude, lastLongitude);
}

static void saveSettings()
{
    Preferences preferences;
    if (!preferences.begin("bfwatch", false)) {
        return;
    }
    preferences.putUChar(
        "gpsmode", static_cast<uint8_t>(gpsUpdateMode));
    preferences.putUChar("scrntime", screenTimeoutIndex);
    preferences.putUChar("bright", screenBrightness);
    preferences.putUChar("alertmode", static_cast<uint8_t>(alertMode));
    preferences.putUChar("volume", alertVolumePercent);
    preferences.putUChar("speedunit", static_cast<uint8_t>(speedUnit));
    preferences.putUChar(
        "watchshop", static_cast<uint8_t>(watchShopMode));
    preferences.putBool("alarmon", clockAlarmEnabled);
    preferences.putUChar("alarmhour", clockAlarmHour);
    preferences.putUChar("alarmmin", clockAlarmMinute);
    preferences.putUChar(
        "alarmrep", static_cast<uint8_t>(clockAlarmRepeat));
    preferences.putUChar("workmins", intervalWorkMinutes);
    preferences.putUChar("breakmins", intervalBreakMinutes);
    preferences.putString("strain", selectedStrainName);
    preferences.end();
}

static void loadSettings()
{
    Preferences preferences;
    if (!preferences.begin("bfwatch", true)) {
        return;
    }
    const uint8_t storedGpsMode = preferences.getUChar(
        "gpsmode", static_cast<uint8_t>(GpsUpdateMode::MANUAL));
    gpsUpdateMode = storedGpsMode <
            static_cast<uint8_t>(GpsUpdateMode::COUNT)
        ? static_cast<GpsUpdateMode>(storedGpsMode)
        : GpsUpdateMode::MANUAL;
    screenTimeoutIndex = preferences.getUChar("scrntime", 0);
    if (screenTimeoutIndex >= SCREEN_TIMEOUT_OPTION_COUNT) {
        screenTimeoutIndex = 0;
    }
    screenBrightness = preferences.getUChar(
        "bright", DEFAULT_SCREEN_BRIGHTNESS);
    screenBrightness = constrain(screenBrightness, 30, 230);
    const uint8_t storedAlert = preferences.getUChar(
        "alertmode", static_cast<uint8_t>(AlertMode::BOTH));
    alertMode = storedAlert < static_cast<uint8_t>(AlertMode::COUNT)
        ? static_cast<AlertMode>(storedAlert) : AlertMode::BOTH;
    alertVolumePercent = constrain(
        preferences.getUChar("volume", 60),
        ALERT_VOLUME_STEP, static_cast<uint8_t>(100));
    alertVolumePercent =
        static_cast<uint8_t>(
            ((alertVolumePercent + ALERT_VOLUME_STEP / 2) /
             ALERT_VOLUME_STEP) * ALERT_VOLUME_STEP);
    const uint8_t storedUnit = preferences.getUChar(
        "speedunit", static_cast<uint8_t>(SpeedUnit::KPH));
    speedUnit = storedUnit < static_cast<uint8_t>(SpeedUnit::COUNT)
        ? static_cast<SpeedUnit>(storedUnit) : SpeedUnit::KPH;
    const uint8_t storedWatchShop = preferences.getUChar(
        "watchshop", static_cast<uint8_t>(WatchShopMode::RANDOM));
    watchShopMode =
        storedWatchShop < static_cast<uint8_t>(WatchShopMode::COUNT)
            ? static_cast<WatchShopMode>(storedWatchShop)
            : WatchShopMode::RANDOM;
    clockAlarmEnabled = preferences.getBool("alarmon", false);
    clockAlarmHour = min(
        preferences.getUChar("alarmhour", 8),
        static_cast<uint8_t>(23));
    clockAlarmMinute = min(
        preferences.getUChar("alarmmin", 0),
        static_cast<uint8_t>(59));
    const uint8_t storedRepeat = preferences.getUChar(
        "alarmrep", static_cast<uint8_t>(AlarmRepeat::DAILY));
    clockAlarmRepeat =
        storedRepeat < static_cast<uint8_t>(AlarmRepeat::COUNT)
            ? static_cast<AlarmRepeat>(storedRepeat)
            : AlarmRepeat::DAILY;
    intervalWorkMinutes = constrain(
        preferences.getUChar("workmins", 25), 1, 90);
    intervalBreakMinutes = constrain(
        preferences.getUChar("breakmins", 5), 1, 30);
    intervalRemainingUs =
        static_cast<uint64_t>(intervalWorkMinutes) *
        60ULL * 1000000ULL;
    const String storedStrain = preferences.getString("strain", "");
    storedStrain.toCharArray(
        selectedStrainName, sizeof(selectedStrainName));
    preferences.end();
}

static void configureRaiseToWakeSensor()
{
    motionSensorReady =
        (instance.getDeviceProbe() & HW_BMA423_ONLINE) != 0;
    if (!motionSensorReady) {
        return;
    }

    instance.sensor.disablePedometerIRQ();
    instance.sensor.disableActivityIRQ();
    instance.sensor.disableAnyNoMotionIRQ();
    instance.sensor.disableWakeupIRQ();
    instance.sensor.disableTiltIRQ();
    instance.sensor.enableFeature(
        SensorBMA423::FEATURE_ANY_MOTION |
        SensorBMA423::FEATURE_NO_MOTION |
        SensorBMA423::FEATURE_ACTIVITY |
        SensorBMA423::FEATURE_TILT |
        SensorBMA423::FEATURE_WAKEUP,
        false);

    // Keep the hardware pedometer active independently of raise-to-wake.
    instance.sensor.configAccelerometer();
    instance.sensor.enableAccelerometer();
    instance.sensor.enablePedometer();

    if (raiseToWakeEnabled) {
        // Level-triggered, active-low, push-pull INT1. Matching the polarity
        // of touch and PMU lets all wake sources share one EXT1 ANY_LOW group.
        instance.sensor.configInterrupt(0, 0);
        instance.sensor.enableFeature(
            SensorBMA423::FEATURE_TILT, true);
        instance.sensor.enableTiltIRQ();
        pinMode(SENSOR_INT, INPUT_PULLUP);
    }
    instance.sensor.readIrqStatus();
}

static void toggleShopFavourite(size_t index)
{
    const uint32_t hash = shopIdentifierHash(index);
    for (size_t i = 0; i < favouriteShopCount; ++i) {
        if (favouriteShopHashes[i] != hash) {
            continue;
        }
        for (size_t j = i + 1; j < favouriteShopCount; ++j) {
            favouriteShopHashes[j - 1] = favouriteShopHashes[j];
        }
        --favouriteShopCount;
        if (watchShopMode == WatchShopMode::FAVOURITES) {
            rotatingWatchShopIndex = -1;
            rotatingWatchShopChangedMs = 0;
        }
        saveShopPreferences();
        return;
    }
    if (favouriteShopCount < MAX_FAVOURITE_SHOPS) {
        favouriteShopHashes[favouriteShopCount++] = hash;
        if (watchShopMode == WatchShopMode::FAVOURITES) {
            rotatingWatchShopIndex = -1;
            rotatingWatchShopChangedMs = 0;
        }
        saveShopPreferences();
    }
}

static double distanceToShop(size_t index)
{
    double latitude = 0.0;
    double longitude = 0.0;
    shopCoordinates(index, latitude, longitude);
    return distanceMeters(lastLatitude, lastLongitude, latitude, longitude);
}

static double bearingToShop(size_t index)
{
    double latitude = 0.0;
    double longitude = 0.0;
    shopCoordinates(index, latitude, longitude);
    return initialBearing(lastLatitude, lastLongitude, latitude, longitude);
}

static bool shopComesBefore(size_t left, size_t right)
{
    const bool leftFavourite = isShopFavourite(left);
    const bool rightFavourite = isShopFavourite(right);
    if (leftFavourite != rightFavourite) {
        return leftFavourite;
    }

    if (haveFix && insideAmsterdam(lastLatitude, lastLongitude)) {
        const double leftDistance = distanceToShop(left);
        const double rightDistance = distanceToShop(right);
        if (fabs(leftDistance - rightDistance) > 0.1) {
            return leftDistance < rightDistance;
        }
    }

    return strcasecmp(
        bfwatchString(BFWATCH_SHOPS[left].nameOffset),
        bfwatchString(BFWATCH_SHOPS[right].nameOffset)) < 0;
}

static void rebuildShopDisplayOrder()
{
    for (size_t i = 0; i < BFWATCH_SHOP_COUNT; ++i) {
        shopDisplayOrder[i] = static_cast<uint16_t>(i);
    }
    for (size_t i = 1; i < BFWATCH_SHOP_COUNT; ++i) {
        const uint16_t value = shopDisplayOrder[i];
        size_t position = i;
        while (position > 0 &&
               shopComesBefore(value, shopDisplayOrder[position - 1])) {
            shopDisplayOrder[position] = shopDisplayOrder[position - 1];
            --position;
        }
        shopDisplayOrder[position] = value;
    }
}

static void calculateNearest()
{
    haveNearest = false;
    nearestName = nullptr;
    nearestShopIndex = -1;

    if (!haveFix) {
        return;
    }

    for (size_t i = 0; i < BFWATCH_SHOP_COUNT; ++i) {
        const WatchShopRecord &shop = BFWATCH_SHOPS[i];
        const double shopLatitude =
            static_cast<double>(shop.latitudeE6) / 1000000.0;
        const double shopLongitude =
            static_cast<double>(shop.longitudeE6) / 1000000.0;
        const double distance = distanceMeters(
            lastLatitude, lastLongitude,
            shopLatitude, shopLongitude);

        if (!haveNearest || distance < nearestDistanceM) {
            haveNearest = true;
            nearestShopIndex = static_cast<int16_t>(i);
            nearestName = bfwatchString(shop.nameOffset);
            nearestDistanceM = distance;
            nearestBearingDeg = initialBearing(
                lastLatitude, lastLongitude,
                shopLatitude, shopLongitude);
        }
    }
}

static void saveFix()
{
    CachedFix fix = {
        FIX_VERSION,
        lastLatitude,
        lastLongitude,
        lastFixEpoch
    };
    Preferences preferences;
    if (preferences.begin("bfwatch", false)) {
        preferences.putBytes("lastfix", &fix, sizeof(fix));
        preferences.end();
    }
}

static void loadFix()
{
    CachedFix fix = {};
    Preferences preferences;
    if (!preferences.begin("bfwatch", true)) {
        return;
    }
    if (preferences.getBytesLength("lastfix") == sizeof(fix)) {
        preferences.getBytes("lastfix", &fix, sizeof(fix));
    }
    preferences.end();

    if (fix.version == FIX_VERSION &&
        isfinite(fix.latitude) && isfinite(fix.longitude) &&
        fix.latitude >= -90.0 && fix.latitude <= 90.0 &&
        fix.longitude >= -180.0 && fix.longitude <= 180.0) {
        haveFix = true;
        lastLatitude = fix.latitude;
        lastLongitude = fix.longitude;
        lastFixEpoch = fix.rtcEpoch;
        calculateNearest();
    }
}

