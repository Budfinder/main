static bool isLeapYear(uint16_t year)
{
    return (year % 4U == 0U && year % 100U != 0U) || year % 400U == 0U;
}

static uint8_t daysInMonth(uint16_t year, uint8_t month)
{
    static const uint8_t days[] = {
        31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31
    };
    if (month == 2) {
        return isLeapYear(year) ? 29 : 28;
    }
    return days[month - 1];
}

static void clampClockDay()
{
    const uint8_t maximum = daysInMonth(clockYear, clockMonth);
    if (clockDay > maximum) {
        clockDay = maximum;
    }
}

static void adjustClockField(int8_t amount)
{
    switch (clockField) {
    case ClockField::YEAR:
        if (amount > 0) {
            clockYear = clockYear >= 2099 ? 2020 : clockYear + 1;
        } else {
            clockYear = clockYear <= 2020 ? 2099 : clockYear - 1;
        }
        clampClockDay();
        break;
    case ClockField::MONTH:
        if (amount > 0) {
            clockMonth = clockMonth >= 12 ? 1 : clockMonth + 1;
        } else {
            clockMonth = clockMonth <= 1 ? 12 : clockMonth - 1;
        }
        clampClockDay();
        break;
    case ClockField::DAY: {
        const uint8_t maximum = daysInMonth(clockYear, clockMonth);
        if (amount > 0) {
            clockDay = clockDay >= maximum ? 1 : clockDay + 1;
        } else {
            clockDay = clockDay <= 1 ? maximum : clockDay - 1;
        }
        break;
    }
    case ClockField::HOUR:
        if (amount > 0) {
            clockHour = (clockHour + 1) % 24;
        } else {
            clockHour = clockHour == 0 ? 23 : clockHour - 1;
        }
        break;
    case ClockField::MINUTE:
        if (amount > 0) {
            clockMinute = (clockMinute + 1) % 60;
        } else {
            clockMinute = clockMinute == 0 ? 59 : clockMinute - 1;
        }
        break;
    }
}

static void selectNextClockField()
{
    clockField = static_cast<ClockField>(
        (static_cast<uint8_t>(clockField) + 1U) % 5U);
}

