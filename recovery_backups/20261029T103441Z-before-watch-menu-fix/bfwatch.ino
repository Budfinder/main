            list, 66, 218, LV_TEXT_ALIGN_CENTER);
        lv_obj_set_x(empty, 4);
        containLabel(empty, 22);
        lv_label_set_text(
            empty, "No favourite strains yet");
        lv_obj_set_style_text_color(
            empty, lv_color_hex(THEME_MUTED), 0);
        return;
    }
    uint16_t position = 0;
    for (uint32_t catalogIndex = 0;
         catalogIndex < strainCatalogCount; ++catalogIndex) {
        const char *name = strainCatalogNames[catalogIndex];
        const bool favourite = isStrainFavourite(name);
        if ((strainFavouritesOpen && !favourite) ||
            (!strainFavouritesOpen &&
             alphabetBucket(name) != strainActiveLetter)) {
            continue;
        }
        const uint16_t stockists = strainStockistCount(name);
        const bool selected =
            selectedStrainName[0] != '\0' &&
            strcasecmp(selectedStrainName, name) == 0;
        char row[128];
