    if (statusLabel != nullptr && lv_label_get_text(statusLabel)[0] == '\0') {
        setLabel(statusLabel, "Hold for 0.5 sec to send");
    }
}

static void updateWifiApView()
{
    if (!jokeApActive || activeJokeSsid == nullptr) {
        setLabel(statusLabel, "Choose one SSID  //  60 seconds");
        return;
    }
    const uint32_t elapsed = millis() - jokeApStartedMs;
    const uint32_t remaining =
        elapsed >= JOKE_AP_DURATION_MS
            ? 0
            : (JOKE_AP_DURATION_MS - elapsed + 999U) / 1000U;
    char buffer[96];
    snprintf(buffer, sizeof(buffer), "ON: %s  //  %us",
             activeJokeSsid, remaining);
    setLabel(statusLabel, buffer);
}

static void updateCurrentView(bool force)
{
    const uint32_t interval =
        currentView == View::STOPWATCH && stopwatchRunning
            ? 100U
            : (currentView == View::SPEEDOMETER &&
               speedometerRunning ? 500U : 1000U);
    if (!force && millis() - lastUiRefreshMs < interval) {
        return;
    }
    lastUiRefreshMs = millis();

    switch (currentView) {
    case View::WATCH:     updateWatchView(); break;
    case View::MENU:      break;
    case View::NEARBY:    break;
    case View::SHOP:      break;
    case View::STRAINS:   break;
    case View::STRAIN_SHOPS: break;
    case View::SPEEDOMETER: updateSpeedometerView(); break;
    case View::STOPWATCH: updateStopwatchView(); break;
    case View::TIMER:     updateTimerView(); break;
    case View::ALARM:     updateAlarmView(); break;
    case View::INTERVAL:  updateIntervalView(); break;
    case View::STEPS:     updateStepsView(); break;
    case View::BATTERY:   updateBatteryView(); break;
    case View::TORCH:     break;
    case View::GPS:       updateGpsView(); break;
    case View::MAP:       updateMapView(); break;
    case View::CLOCK:     updateClockView(); break;
    case View::IR:        updateIrView(); break;
    case View::SETTINGS:  break;
    case View::WIFI_AP:   updateWifiApView(); break;
    }
    updateBatteryBadge();
    updateRunningAppsLabel();
}

