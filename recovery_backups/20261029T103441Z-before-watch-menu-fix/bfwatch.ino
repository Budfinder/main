static uint32_t strainNameColour(uint8_t type, uint8_t flags)
{
    if (flags & WATCH_STRAIN_CALI) {
        return 0xE88966;
    }
    switch (type) {
    case WATCH_STRAIN_INDICA: return 0xC6A3DC;
    case WATCH_STRAIN_SATIVA: return 0xE5B65D;
    case WATCH_STRAIN_HYBRID: return 0x76C6B2;
    case WATCH_STRAIN_KUSH:   return 0x9FC67B;
    default:                  return THEME_TEXT;
    }
}

static void buildShopView()
