    uint16_t favouriteCount = 0;
    for (size_t index = 0; index < BFWATCH_SHOP_COUNT; ++index) {
        const char *name =
            bfwatchString(BFWATCH_SHOPS[index].nameOffset);
        ++letterCounts[alphabetBucket(name)];
        if (isShopFavourite(index)) {
            ++favouriteCount;
        }
    }

    if (!menusGroupOpen) {
        lv_label_set_text(title, "MENUS A-Z");
        lv_label_set_text(statusLabel, "Choose group or letter");
        uint8_t populatedLetters = 0;
        for (uint8_t bucket = 0;
             bucket < ALPHABET_BUCKET_COUNT; ++bucket) {
            if (letterCounts[bucket] > 0) {
                ++populatedLetters;
            }
        }
        const uint8_t groupCount =
            1 + (favouriteCount > 0 ? 1 : 0) + populatedLetters;
        lv_obj_t *list = makeVerticalList(
            6, 84, 228, 150,
            max(150L, static_cast<int32_t>(groupCount) * 48),
            &menusScrollOffset);
        uint8_t position = 0;
        char row[64];
        snprintf(row, sizeof(row), "ALL SHOPS\n%u shops",
                 static_cast<unsigned>(BFWATCH_SHOP_COUNT));
        makeListButton(list, row, position * 48 + 3, 17000);
        ++position;
        if (favouriteCount > 0) {
            snprintf(row, sizeof(row), "FAVOURITES\n%u shop%s",
                     static_cast<unsigned>(favouriteCount),
                     favouriteCount == 1 ? "" : "s");
            makeListButton(list, row, position * 48 + 3, 17001);
            ++position;
        }
        for (uint8_t bucket = 0;
             bucket < ALPHABET_BUCKET_COUNT; ++bucket) {
            if (letterCounts[bucket] == 0) {
                continue;
            }
            const char letter = bucket == ALPHABET_OTHER_BUCKET
                ? '#' : static_cast<char>('A' + bucket);
            snprintf(row, sizeof(row), "%c\n%u shop%s",
                     letter,
                     static_cast<unsigned>(letterCounts[bucket]),
                     letterCounts[bucket] == 1 ? "" : "s");
            makeListButton(
                list, row, position * 48 + 3,
                17100 + static_cast<intptr_t>(bucket));
            ++position;
        }
        return;
    }

    if (menusActiveGroup == -1) {
        lv_label_set_text(title, "ALL SHOPS");
    } else if (menusActiveGroup == -2) {
        lv_label_set_text(title, "FAV SHOPS");
    } else {
        const char letter =
            menusActiveGroup == ALPHABET_OTHER_BUCKET
                ? '#'
                : static_cast<char>('A' + menusActiveGroup);
        char heading[20];
        snprintf(heading, sizeof(heading), "%c SHOPS", letter);
        lv_label_set_text(title, heading);
    }
    if (menusActiveGroup == -2) {
        lv_label_set_text(statusLabel, "Saved favourites");
    } else if (haveFix &&
               insideAmsterdam(lastLatitude, lastLongitude)) {
        lv_label_set_text(statusLabel, "Favourites, then distance");
    } else {
        lv_label_set_text(statusLabel, "Favourites, then A-Z");
    }

    rebuildShopDisplayOrder();
    uint16_t visibleCount = 0;
    for (size_t position = 0;
         position < BFWATCH_SHOP_COUNT; ++position) {
        const size_t index = shopDisplayOrder[position];
        const char *name =
            bfwatchString(BFWATCH_SHOPS[index].nameOffset);
        const bool visible =
            menusActiveGroup == -1 ||
            (menusActiveGroup == -2 && isShopFavourite(index)) ||
            (menusActiveGroup >= 0 &&
             alphabetBucket(name) ==
                 static_cast<uint8_t>(menusActiveGroup));
        if (visible) {
            ++visibleCount;
        }
    }
    lv_obj_t *list = makeVerticalList(
        6, 84, 228, 150,
        max(150L, static_cast<int32_t>(visibleCount) * 48),
        &menusScrollOffset);
    if (visibleCount == 0) {
        lv_obj_t *empty = makeLabel(
            list, 64, 218, LV_TEXT_ALIGN_CENTER);
        lv_obj_set_x(empty, 4);
        containLabel(empty, 22);
        lv_label_set_text(empty, "No shops in this group");
        lv_obj_set_style_text_color(
            empty, lv_color_hex(THEME_MUTED), 0);
        return;
    }
    const bool showLogos = loadMenuLogoBuffer();

    uint16_t visiblePosition = 0;
    for (size_t orderPosition = 0;
         orderPosition < BFWATCH_SHOP_COUNT; ++orderPosition) {
        const size_t index = shopDisplayOrder[orderPosition];
        const char *name = bfwatchString(BFWATCH_SHOPS[index].nameOffset);
        const bool favourite = isShopFavourite(index);
        const bool visible =
            menusActiveGroup == -1 ||
            (menusActiveGroup == -2 && favourite) ||
            (menusActiveGroup >= 0 &&
             alphabetBucket(name) ==
                 static_cast<uint8_t>(menusActiveGroup));
        if (!visible) {
            continue;
        }
        const int logoNameLength = favourite ? 16 : 20;
        char row[80];
        if (haveFix && insideAmsterdam(lastLatitude, lastLongitude)) {
            char distance[20];
            formatDistance(distanceToShop(index), distance, sizeof(distance));
            if (showLogos) {
                snprintf(row, sizeof(row), "%s%.*s\n%s",
                         favourite ? "FAV  " : "",
                         logoNameLength, name, distance);
            } else {
                snprintf(row, sizeof(row), "%s%.25s  %s",
                         favourite ? "FAV  " : "",
                         name, distance);
            }
        } else {
            const int maximumNameLength = showLogos ? logoNameLength : 31;
            snprintf(row, sizeof(row), "%s%.*s",
                     favourite ? "FAV  " : "",
                     maximumNameLength, name);
        }
        lv_obj_t *button = makeListButton(
            list, row, visiblePosition * 48 + 3,
            6000 + static_cast<intptr_t>(index));
        if (showLogos) {
            addMenuRowLogo(button, index);
        }
        ++visiblePosition;
    }
}

static uint16_t strainStockistCount(const char *strainName)
{
    uint16_t count = 0;
    for (size_t index = 0; index < BFWATCH_SHOP_COUNT; ++index) {
        if (shopStocksStrain(index, strainName)) {
            ++count;
        }
    }
    return count;
}

