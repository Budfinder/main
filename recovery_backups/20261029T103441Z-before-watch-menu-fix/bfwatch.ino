            list, row, position * 48 + 3,
            10000 + static_cast<intptr_t>(catalogIndex));
        lv_obj_t *label = lv_obj_get_child(button, 0);
        if (label != nullptr) {
            lv_obj_set_style_text_font(
                label, &lv_font_montserrat_12, 0);
        }
        ++position;
    }
}

