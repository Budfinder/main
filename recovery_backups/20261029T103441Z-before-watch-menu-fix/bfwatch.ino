static void formatDuration(uint64_t totalMs, bool showTenths,
                           char *buffer, size_t bufferSize)
{
    const uint32_t hours = totalMs / 3600000ULL;
    const uint32_t minutes = (totalMs / 60000ULL) % 60ULL;
    const uint32_t seconds = (totalMs / 1000ULL) % 60ULL;
    const uint32_t tenths = (totalMs / 100ULL) % 10ULL;

    if (showTenths) {
        snprintf(buffer, bufferSize, "%02u:%02u:%02u.%u",
                 hours, minutes, seconds, tenths);
    } else {
        snprintf(buffer, bufferSize, "%02u:%02u:%02u",
                 hours, minutes, seconds);
    }
}

static void formatDistance(double meters, char *buffer, size_t bufferSize)
{
    if (speedUnit == SpeedUnit::MPH) {
        const double miles = meters / 1609.344;
        if (meters < 160.9344) {
            snprintf(
                buffer, bufferSize, "%.0f ft", meters * 3.280839895);
        } else if (miles < 100.0) {
            snprintf(buffer, bufferSize, "%.1f mi", miles);
        } else {
            snprintf(buffer, bufferSize, "%.0f mi", miles);
        }
    } else if (meters < 1000.0) {
        snprintf(buffer, bufferSize, "%.0f m", meters);
    } else if (meters < 100000.0) {
        snprintf(buffer, bufferSize, "%.1f km", meters / 1000.0);
    } else {
        snprintf(buffer, bufferSize, "%.0f km", meters / 1000.0);
    }
}

