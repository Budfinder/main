static void addMapMovable(lv_obj_t *object, int16_t x, int16_t y)
{
    if (object == nullptr || mapMovableCount >= MAX_MAP_MOVABLES) {
        return;
    }
    lv_obj_set_pos(object, x, y);
    mapMovables[mapMovableCount++] = {object, x, y};
}

static void addMapMarkerPoint(int16_t x, int16_t y, uint16_t shopIndex,
                              uint8_t size, uint8_t priority,
                              bool useLogo, uint32_t fill, uint32_t border)
{
    if (mapMarkerPointCount >= BFWATCH_SHOP_COUNT + 1) {
        return;
    }
    mapMarkerPoints[mapMarkerPointCount++] = {
        x, y, x, y, shopIndex, size, priority, useLogo, fill, border
    };
}

static bool mapMarkerOverlapsPlaced(
    int16_t x, int16_t y, uint8_t size, size_t placedCount)
{
    for (size_t index = 0; index < placedCount; ++index) {
        const MapMarkerPoint &other = mapMarkerPoints[index];
        const int32_t deltaX = x - other.x;
        const int32_t deltaY = y - other.y;
        const int32_t separation =
            (static_cast<int32_t>(size) + other.size) / 2 + 1;
        if (deltaX * deltaX + deltaY * deltaY <
            separation * separation) {
            return true;
        }
    }
    return false;
}

static bool mapMarkerPositionClear(
    int16_t x, int16_t y, uint8_t size, size_t placedCount)
{
    const int16_t radius = size / 2;
    if (x < radius + 2 || x > MAP_VIEW_SIZE - radius - 2 ||
        y < radius + 2 || y > MAP_VIEW_SIZE - radius - 2) {
        return false;
    }
    if (mapMarkerOverlapsPlaced(x, y, size, placedCount)) {
        return false;
    }
    return true;
}

static void resolveMapMarkerCollisions()
{
    if (mapZoom < 13 || mapMarkerPointCount < 2) {
        return;
    }

    // Keep selected and favourite/filtered markers closest to their true
    // coordinate; ordinary markers yield to them when positions collide.
    for (size_t index = 1; index < mapMarkerPointCount; ++index) {
        const MapMarkerPoint marker = mapMarkerPoints[index];
        size_t insertion = index;
        while (insertion > 0 &&
               mapMarkerPoints[insertion - 1].priority <
                   marker.priority) {
            mapMarkerPoints[insertion] =
                mapMarkerPoints[insertion - 1];
            --insertion;
        }
        mapMarkerPoints[insertion] = marker;
    }

    // Search every one-pixel radius in sixteen directions. This finds the
    // nearest clear position instead of jumping markers onto wide spokes.
    static constexpr int16_t directions[][2] = {
        {1000, 0}, {924, 383}, {707, 707}, {383, 924},
        {0, 1000}, {-383, 924}, {-707, 707}, {-924, 383},
        {-1000, 0}, {-924, -383}, {-707, -707}, {-383, -924},
        {0, -1000}, {383, -924}, {707, -707}, {924, -383}
    };

    for (size_t markerIndex = 1;
        markerIndex < mapMarkerPointCount; ++markerIndex) {
        MapMarkerPoint &marker = mapMarkerPoints[markerIndex];
        if (!mapMarkerOverlapsPlaced(
                marker.x, marker.y, marker.size, markerIndex)) {
            continue;
        }

        const uint8_t directionStart =
            static_cast<uint8_t>(marker.shopIndex % 16U);
        bool positioned = false;
        for (int16_t radius = 1; radius <= 64; ++radius) {
            for (uint8_t attempt = 0; attempt < 16; ++attempt) {
                const uint8_t direction =
                    (directionStart + attempt) % 16U;
                const int32_t scaledX =
                    static_cast<int32_t>(
                        directions[direction][0]) * radius;
                const int32_t scaledY =
                    static_cast<int32_t>(
                        directions[direction][1]) * radius;
                const int16_t candidateX =
                    marker.anchorX +
                    static_cast<int16_t>(
                        scaledX >= 0
                            ? (scaledX + 500) / 1000
                            : (scaledX - 500) / 1000);
                const int16_t candidateY =
                    marker.anchorY +
                    static_cast<int16_t>(
                        scaledY >= 0
                            ? (scaledY + 500) / 1000
                            : (scaledY - 500) / 1000);
                if (mapMarkerPositionClear(
                        candidateX, candidateY,
                        marker.size, markerIndex)) {
                    marker.x = candidateX;
                    marker.y = candidateY;
                    positioned = true;
                    break;
                }
            }
            if (positioned) {
                break;
            }
        }
    }
}

static lv_color32_t mapOverlayColour(uint32_t rgb)
{
    lv_color32_t colour = {};
    colour.red = (rgb >> 16) & 0xFF;
    colour.green = (rgb >> 8) & 0xFF;
    colour.blue = rgb & 0xFF;
    colour.alpha = 0xFF;
    return colour;
}

static void setMapOverlayPixel(int16_t x, int16_t y, lv_color32_t colour)
{
    if (mapOverlayBuffer == nullptr ||
        x < 0 || x >= MAP_VIEW_SIZE || y < 0 || y >= MAP_VIEW_SIZE) {
        return;
    }
    lv_color32_t *row = reinterpret_cast<lv_color32_t *>(
        mapOverlayBuffer + static_cast<size_t>(y) * mapOverlayStride);
    row[x] = colour;
}

static void paintMapOverlayCircle(size_t markerIndex)
{
    const MapMarkerPoint &marker = mapMarkerPoints[markerIndex];
    const int16_t radius = marker.size / 2;
    const int16_t inset = marker.size >= 10 ? 2 : 1;
    const int16_t innerRadius = radius > inset ? radius - inset : 0;
    const int16_t radiusSquared = radius * radius;
    const int16_t innerSquared = innerRadius * innerRadius;
    const lv_color32_t fill = mapOverlayColour(marker.fill);
    const lv_color32_t border = mapOverlayColour(marker.border);

    for (int16_t y = -radius; y <= radius; ++y) {
        for (int16_t x = -radius; x <= radius; ++x) {
            const int16_t distanceSquared = x * x + y * y;
            if (distanceSquared <= radiusSquared) {
                setMapOverlayPixel(
                    marker.x + x, marker.y + y,
                    distanceSquared <= innerSquared ? fill : border);
            }
        }
    }
}

static void blendMapOverlayPixel(
    int16_t x, int16_t y, const lv_color32_t &source)
{
    if (mapOverlayBuffer == nullptr || source.alpha == 0 ||
        x < 0 || x >= MAP_VIEW_SIZE || y < 0 || y >= MAP_VIEW_SIZE) {
        return;
    }
    lv_color32_t *row = reinterpret_cast<lv_color32_t *>(
        mapOverlayBuffer + static_cast<size_t>(y) * mapOverlayStride);
    lv_color32_t &destination = row[x];
    if (source.alpha == 255 || destination.alpha == 0) {
        destination = source;
        return;
    }

    const uint32_t sourceAlpha = source.alpha;
    const uint32_t backgroundAlpha =
        static_cast<uint32_t>(destination.alpha) *
        (255U - sourceAlpha) / 255U;
    const uint32_t outputAlpha = sourceAlpha + backgroundAlpha;
    if (outputAlpha == 0) {
        destination = {};
        return;
    }
    destination.red = static_cast<uint8_t>(
        (source.red * sourceAlpha +
         destination.red * backgroundAlpha) / outputAlpha);
    destination.green = static_cast<uint8_t>(
        (source.green * sourceAlpha +
         destination.green * backgroundAlpha) / outputAlpha);
    destination.blue = static_cast<uint8_t>(
        (source.blue * sourceAlpha +
         destination.blue * backgroundAlpha) / outputAlpha);
    destination.alpha = static_cast<uint8_t>(outputAlpha);
}

static lv_color32_t sampleCompactLogoPixel(
    const lv_color32_t *pixels, uint16_t targetX, uint16_t targetY)
{
    const uint16_t sourceLeft =
        targetX * BFWATCH_LOGO_WIDTH / COMPACT_LOGO_SIZE;
    const uint16_t calculatedRight =
        (targetX + 1) * BFWATCH_LOGO_WIDTH / COMPACT_LOGO_SIZE;
    const uint16_t sourceRight =
        calculatedRight > sourceLeft ? calculatedRight : sourceLeft + 1;
    const uint16_t sourceTop =
        targetY * BFWATCH_LOGO_HEIGHT / COMPACT_LOGO_SIZE;
    const uint16_t calculatedBottom =
        (targetY + 1) * BFWATCH_LOGO_HEIGHT / COMPACT_LOGO_SIZE;
    const uint16_t sourceBottom =
        calculatedBottom > sourceTop ? calculatedBottom : sourceTop + 1;

    uint32_t alphaTotal = 0;
    uint32_t redTotal = 0;
    uint32_t greenTotal = 0;
    uint32_t blueTotal = 0;
    uint32_t sampleCount = 0;
    for (uint16_t y = sourceTop;
         y < min(sourceBottom, BFWATCH_LOGO_HEIGHT); ++y) {
        for (uint16_t x = sourceLeft;
             x < min(sourceRight, BFWATCH_LOGO_WIDTH); ++x) {
            const lv_color32_t &pixel =
                pixels[static_cast<size_t>(y) * BFWATCH_LOGO_WIDTH + x];
            alphaTotal += pixel.alpha;
            redTotal += static_cast<uint32_t>(pixel.red) * pixel.alpha;
            greenTotal += static_cast<uint32_t>(pixel.green) * pixel.alpha;
            blueTotal += static_cast<uint32_t>(pixel.blue) * pixel.alpha;
            ++sampleCount;
        }
    }

    lv_color32_t result = {};
    if (sampleCount == 0 || alphaTotal == 0) {
        return result;
    }
    result.red = static_cast<uint8_t>(redTotal / alphaTotal);
    result.green = static_cast<uint8_t>(greenTotal / alphaTotal);
    result.blue = static_cast<uint8_t>(blueTotal / alphaTotal);
    result.alpha = static_cast<uint8_t>(alphaTotal / sampleCount);
    return result;
}

static bool paintMapOverlayLogo(
    size_t markerIndex, File &logoData)
{
    const MapMarkerPoint &marker = mapMarkerPoints[markerIndex];
    if (!marker.useLogo || marker.shopIndex == UINT16_MAX ||
        !logoPackageReady || !logoData) {
        return false;
    }
    const int32_t recordIndex = findLogoRecordIndex(
        shopIdentifierHash(marker.shopIndex));
    if (recordIndex < 0) {
        return false;
    }

    const size_t spriteBytes =
        static_cast<size_t>(BFWATCH_LOGO_WIDTH) *
        BFWATCH_LOGO_HEIGHT * sizeof(lv_color32_t);
    if (mapLogoSpriteBuffer == nullptr) {
        mapLogoSpriteBuffer =
            static_cast<uint8_t *>(ps_malloc(spriteBytes));
    }
    if (mapLogoSpriteBuffer == nullptr) {
        return false;
    }

    const LogoIndexRecord &record = logoIndexRecords[recordIndex];
    if (!logoData.seek(record.offset) ||
        logoData.read(mapLogoSpriteBuffer, spriteBytes) != spriteBytes) {
        return false;
    }
    const lv_color32_t *pixels =
        reinterpret_cast<const lv_color32_t *>(mapLogoSpriteBuffer);
    const int16_t left =
        marker.x - static_cast<int16_t>(COMPACT_LOGO_SIZE / 2U);
    const int16_t top =
        marker.y - static_cast<int16_t>(COMPACT_LOGO_SIZE / 2U);
    for (uint16_t y = 0; y < COMPACT_LOGO_SIZE; ++y) {
        for (uint16_t x = 0; x < COMPACT_LOGO_SIZE; ++x) {
            blendMapOverlayPixel(
                left + x, top + y,
                sampleCompactLogoPixel(pixels, x, y));
        }
    }
    return true;
}

static void createMapMarkerOverlay()
{
    mapOverlayStride = lv_draw_buf_width_to_stride(
        MAP_VIEW_SIZE, LV_COLOR_FORMAT_ARGB8888);
    const size_t bufferSize =
        static_cast<size_t>(mapOverlayStride) * MAP_VIEW_SIZE;
    if (mapOverlayBuffer == nullptr) {
        mapOverlayBuffer = static_cast<uint8_t *>(ps_malloc(bufferSize));
    }
    if (mapOverlayBuffer == nullptr) {
        Serial.println("Map marker overlay allocation failed");
        return;
    }
    memset(mapOverlayBuffer, 0, bufferSize);

    File logoData;
    if (logoPackageReady) {
        logoData = FFat.open("/logos.bin", FILE_READ);
    }
    for (uint8_t priority = 0; priority <= 3; ++priority) {
        for (size_t index = 0; index < mapMarkerPointCount; ++index) {
            if (mapMarkerPoints[index].priority == priority) {
                const MapMarkerPoint &marker = mapMarkerPoints[index];
                const bool needsSurround =
                    marker.useLogo &&
                    marker.size > COMPACT_LOGO_SIZE;
                if (needsSurround) {
                    paintMapOverlayCircle(index);
                }
                const bool paintedLogo =
                    paintMapOverlayLogo(index, logoData);
                if (!paintedLogo && !needsSurround) {
                    paintMapOverlayCircle(index);
                }
            }
        }
    }
    logoData.close();

    lv_obj_t *canvas = lv_canvas_create(mapViewport);
    lv_canvas_set_buffer(canvas, mapOverlayBuffer,
                         MAP_VIEW_SIZE, MAP_VIEW_SIZE,
                         LV_COLOR_FORMAT_ARGB8888);
    lv_obj_clear_flag(canvas, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_clear_flag(canvas, LV_OBJ_FLAG_SCROLLABLE);
    addMapMovable(canvas, 0, 0);
}

static void drawMapTilesAndMarkers()
{
    mapMovableCount = 0;
    mapMarkerPointCount = 0;
    mapLoadedTileCount = 0;
    mapMissingTileCount = 0;

    const double centreWorldX =
        longitudeToWorldX(mapCenterLongitude, mapZoom);
    const double centreWorldY =
        latitudeToWorldY(mapCenterLatitude, mapZoom);
    const double leftWorld = centreWorldX - MAP_VIEW_SIZE / 2.0;
    const double topWorld = centreWorldY - MAP_VIEW_SIZE / 2.0;
    const int32_t firstTileX =
        static_cast<int32_t>(floor(leftWorld / BFWATCH_MAP_TILE_SIZE));
    const int32_t firstTileY =
        static_cast<int32_t>(floor(topWorld / BFWATCH_MAP_TILE_SIZE));
    const int32_t lastTileX =
        static_cast<int32_t>(floor(
            (leftWorld + MAP_VIEW_SIZE - 1.0) / BFWATCH_MAP_TILE_SIZE));
    const int32_t lastTileY =
        static_cast<int32_t>(floor(
            (topWorld + MAP_VIEW_SIZE - 1.0) / BFWATCH_MAP_TILE_SIZE));

    for (int32_t tileX = firstTileX; tileX <= lastTileX; ++tileX) {
        for (int32_t tileY = firstTileY; tileY <= lastTileY; ++tileY) {
            if (!mapStorageReady ||
                findMapPackEntry(mapZoom, tileX, tileY) == nullptr) {
                ++mapMissingTileCount;
                continue;
            }

            char lvglPath[64];
            snprintf(lvglPath, sizeof(lvglPath), "P:/%u/%ld/%ld.jpg",
                     mapZoom, static_cast<long>(tileX),
                     static_cast<long>(tileY));
            lv_obj_t *image = lv_image_create(mapViewport);
            lv_image_set_src(image, lvglPath);
            lv_obj_clear_flag(image, LV_OBJ_FLAG_CLICKABLE);
            lv_obj_clear_flag(image, LV_OBJ_FLAG_SCROLLABLE);
            const int16_t x = static_cast<int16_t>(lround(
                tileX * BFWATCH_MAP_TILE_SIZE - leftWorld));
            const int16_t y = static_cast<int16_t>(lround(
                tileY * BFWATCH_MAP_TILE_SIZE - topWorld));
            addMapMovable(image, x, y);
            ++mapLoadedTileCount;
        }
    }

    mapPackageReady = mapLoadedTileCount > 0;
    mapDragStartWorldX = centreWorldX;
    mapDragStartWorldY = centreWorldY;
    if (!mapPackageReady) {
        return;
    }

    const uint8_t ordinarySize = mapZoom >= 14 ? 8 : (mapZoom == 13 ? 6 : 4);
    for (size_t index = 0; index < BFWATCH_SHOP_COUNT; ++index) {
        if (mapStrainFilterActive &&
            !shopStocksStrain(index, selectedStrainName)) {
            continue;
        }
        double latitude;
        double longitude;
        shopCoordinates(index, latitude, longitude);
        const int16_t x = static_cast<int16_t>(lround(
            longitudeToWorldX(longitude, mapZoom) - leftWorld));
        const int16_t y = static_cast<int16_t>(lround(
            latitudeToWorldY(latitude, mapZoom) - topWorld));
        if (x < -12 || x > MAP_VIEW_SIZE + 12 ||
            y < -12 || y > MAP_VIEW_SIZE + 12) {
            continue;
        }

        const bool selected =
            mapFocusedShopIndex == static_cast<int16_t>(index);
        const bool favourite = isShopFavourite(index);
        const bool useLogo =
            logoPackageReady &&
            !mapStrainFilterActive &&
            (mapZoom >= 15 || favourite || selected);
        const uint8_t size = mapStrainFilterActive
            ? (useLogo
                ? (selected ? 30 : 27)
                : (selected ? 13 : (mapZoom >= 13 ? 10 : 8)))
            : (useLogo
                ? (selected ? 30 : (favourite ? 27 : 24))
                : (selected ? 13 : (favourite ? 10 : ordinarySize)));
        const uint32_t fill =
            selected ? 0xFFD166 :
            (mapStrainFilterActive ? THEME_ACCENT :
             (favourite ? 0xFF6FAE : 0x1CCB75));
        const uint32_t border =
            selected ? 0x4A3510 :
            (mapStrainFilterActive ? THEME_TEXT : 0x073D29);
        addMapMarkerPoint(
            x, y, static_cast<uint16_t>(index), size,
            selected ? 2 :
            ((mapStrainFilterActive || favourite) ? 1 : 0),
            useLogo, fill, border);
    }

    // A strain can have many stockists across Amsterdam while only a handful
    // are visible at a close zoom. Decide logo density from this viewport,
    // not the city-wide stockist total used to auto-fit the initial map.
    if (mapStrainFilterActive &&
        mapZoom >= 13 &&
        logoPackageReady &&
        mapMarkerPointCount <= STRAIN_MAP_LOGO_MAX_STOCKISTS) {
        for (size_t index = 0; index < mapMarkerPointCount; ++index) {
            MapMarkerPoint &marker = mapMarkerPoints[index];
            marker.useLogo = true;
            marker.size =
                marker.shopIndex ==
                    static_cast<uint16_t>(mapFocusedShopIndex)
                ? 30
                : 27;
        }
    }

    resolveMapMarkerCollisions();

    if (haveFix && insideAmsterdam(lastLatitude, lastLongitude)) {
        const int16_t x = static_cast<int16_t>(lround(
            longitudeToWorldX(lastLongitude, mapZoom) - leftWorld));
        const int16_t y = static_cast<int16_t>(lround(
            latitudeToWorldY(lastLatitude, mapZoom) - topWorld));
        if (x >= -12 && x <= MAP_VIEW_SIZE + 12 &&
            y >= -12 && y <= MAP_VIEW_SIZE + 12) {
            addMapMarkerPoint(
                x, y, UINT16_MAX, 15, 3, false,
                0xE63946, 0xFFFFFF);
        }
    }
    createMapMarkerOverlay();
}

static void buildMapView()
{
    Serial.printf("Map open: heap=%u psram=%u package=%u\n",
                  static_cast<unsigned>(ESP.getFreeHeap()),
                  static_cast<unsigned>(ESP.getFreePsram()),
                  mapPackageReady ? 1U : 0U);
    prepareScreen();
    if (!mapPackageReady) {
        makeButton(
            lv_scr_act(), "Back", 6, 5, 66, 36, ACTION_MAP_BACK);
        lv_obj_t *title = makeLabel(lv_scr_act(), 18, 150);
        lv_obj_set_pos(title, 82, 18);
        containLabel(title, 26);
        lv_label_set_text(title, "OFFLINE MAP");
        lv_obj_set_style_text_font(title, &lv_font_montserrat_20, 0);

        primaryLabel = makeLabel(lv_scr_act(), 75, 212);
        containLabel(primaryLabel, 72, LV_LABEL_LONG_WRAP);
        lv_label_set_text(primaryLabel,
            "Map files are incomplete.\n"
            "Run upload_watch_map.py\n"
            "while the watch is awake.");
        makeButton(lv_scr_act(), "Location", 55, 174, 130, 52, 300);
        Serial.println("Map safe screen: representative tile not installed");
        return;
    }
    if (!mapCenterInitialized) {
        resetMapCenter();
    }

    mapViewport = lv_obj_create(lv_scr_act());
    lv_obj_remove_style_all(mapViewport);
