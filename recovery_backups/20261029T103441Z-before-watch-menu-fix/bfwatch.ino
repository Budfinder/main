static void loadClockEditor()
{
    struct tm now = {};
    instance.rtc.getDateTime(&now);
    if (now.tm_year + 1900 >= 2020) {
        clockYear = now.tm_year + 1900;
        clockMonth = now.tm_mon + 1;
        clockDay = now.tm_mday;
        clockHour = now.tm_hour;
        clockMinute = now.tm_min;
    }
    clockField = ClockField::HOUR;
    clockEditorLoaded = true;
}

