static void formatScreenTimeout(char *buffer, size_t bufferSize)
{
    const uint32_t seconds =
        SCREEN_TIMEOUT_OPTIONS_MS[screenTimeoutIndex] / 1000U;
    if (seconds < 60U) {
        snprintf(buffer, bufferSize, "%u SEC", seconds);
    } else {
        snprintf(buffer, bufferSize, "%u MIN", seconds / 60U);
    }
}

