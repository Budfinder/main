            char text[112];
            snprintf(text, sizeof(text),
                     "#%06lX %s#\n#%06lX %sEUR %u.%02u/g#",
                     static_cast<unsigned long>(
                         strainNameColour(strain.type, strain.flags)),
                     strain.name,
                     static_cast<unsigned long>(THEME_MUTED),
                     strain.flags & WATCH_STRAIN_CALI ? "CALI  " : "",
                     strain.priceCents / 100,
                     strain.priceCents % 100);
            lv_label_set_text(line, text);
        }
    }
}

