static void runningAppSymbols(char *buffer, size_t bufferSize)
{
    buffer[0] = '\0';
    const auto append = [&](const char *symbol) {
        strlcat(buffer, symbol, bufferSize);
    };
    if (stopwatchRunning) {
        append(LV_SYMBOL_PLAY);
    }
    if (timerRunning || clockAlarmEnabled || alertRinging) {
        append(LV_SYMBOL_BELL);
    }
    if (intervalRunning) {
        append(LV_SYMBOL_LOOP);
    }
    if (speedometerRunning || gpsAcquiring) {
        append(LV_SYMBOL_GPS);
    }
    if (jokeApActive) {
        append(LV_SYMBOL_WIFI);
    }
    if (alertAudioPlaying) {
        append(LV_SYMBOL_AUDIO);
    }
}

