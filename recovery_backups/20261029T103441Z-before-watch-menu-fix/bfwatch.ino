static void clearNavigationHistory()
{
    navigationHistoryCount = 0;
}

static void rememberCurrentView()
{
    if (navigationHistoryCount > 0 &&
        navigationHistory[navigationHistoryCount - 1].view == currentView) {
        return;
    }
    if (navigationHistoryCount >= MAX_NAVIGATION_HISTORY) {
        memmove(
            navigationHistory,
            navigationHistory + 1,
            (MAX_NAVIGATION_HISTORY - 1) * sizeof(navigationHistory[0]));
        navigationHistoryCount = MAX_NAVIGATION_HISTORY - 1;
    }
    NavigationState &state =
        navigationHistory[navigationHistoryCount++];
    state = {};
    state.view = currentView;
    state.detailShopIndex = detailShopIndex;
    state.appsScrollOffset = appsScrollOffset;
    state.menusScrollOffset = menusScrollOffset;
    state.shopStrainScrollOffset = shopStrainScrollOffset;
    state.strainsScrollOffset = strainsScrollOffset;
    state.strainShopsScrollOffset = strainShopsScrollOffset;
    state.settingsScrollOffset = settingsScrollOffset;
    state.menusActiveGroup = menusActiveGroup;
    state.strainActiveLetter = strainActiveLetter;
    state.menusGroupOpen = menusGroupOpen;
    state.strainLetterOpen = strainLetterOpen;
    state.strainFavouritesOpen = strainFavouritesOpen;
    snprintf(
        state.selectedStrainName,
        sizeof(state.selectedStrainName),
        "%s", selectedStrainName);
}

static View previousNavigationView(View fallback)
{
    return navigationHistoryCount > 0
        ? navigationHistory[navigationHistoryCount - 1].view
        : fallback;
}

static void navigateBack(View fallback)
{
    if (navigationHistoryCount == 0) {
        currentView = fallback;
        buildCurrentView();
        return;
    }
    const NavigationState state =
        navigationHistory[--navigationHistoryCount];
    currentView = state.view;
    detailShopIndex = state.detailShopIndex;
    appsScrollOffset = state.appsScrollOffset;
    menusScrollOffset = state.menusScrollOffset;
    shopStrainScrollOffset = state.shopStrainScrollOffset;
    strainsScrollOffset = state.strainsScrollOffset;
    strainShopsScrollOffset = state.strainShopsScrollOffset;
    settingsScrollOffset = state.settingsScrollOffset;
    menusActiveGroup = state.menusActiveGroup;
    strainActiveLetter = state.strainActiveLetter;
    menusGroupOpen = state.menusGroupOpen;
    strainLetterOpen = state.strainLetterOpen;
    strainFavouritesOpen = state.strainFavouritesOpen;
    snprintf(
        selectedStrainName,
        sizeof(selectedStrainName),
        "%s", state.selectedStrainName);
    buildCurrentView();
}

static int64_t monotonicUs()
{
    return esp_timer_get_time();
}

static int64_t readRtcEpoch()
{
    struct tm now = {};
    instance.rtc.getDateTime(&now);
    if (now.tm_year + 1900 < 2020) {
        return 0;
    }
    now.tm_isdst = -1;
    return static_cast<int64_t>(mktime(&now));
}

static bool insideAmsterdam(double latitude, double longitude)
{
    return latitude >= BFWATCH_MAP_SOUTH &&
           latitude <= BFWATCH_MAP_NORTH &&
           longitude >= BFWATCH_MAP_WEST &&
           longitude <= BFWATCH_MAP_EAST;
}

static double mapWorldSize(uint8_t zoom)
{
    return static_cast<double>(BFWATCH_MAP_TILE_SIZE) *
           static_cast<double>(1UL << zoom);
}

static double longitudeToWorldX(double longitude, uint8_t zoom)
{
    return (longitude + 180.0) / 360.0 * mapWorldSize(zoom);
}

static double latitudeToWorldY(double latitude, uint8_t zoom)
{
    latitude = constrain(latitude, -85.05112878, 85.05112878);
    const double radians = latitude * M_PI / 180.0;
    return (1.0 - asinh(tan(radians)) / M_PI) * 0.5 *
           mapWorldSize(zoom);
}

static double worldXToLongitude(double worldX, uint8_t zoom)
{
    return worldX / mapWorldSize(zoom) * 360.0 - 180.0;
}

static double worldYToLatitude(double worldY, uint8_t zoom)
{
    const double mercator =
        M_PI * (1.0 - 2.0 * worldY / mapWorldSize(zoom));
    return atan(sinh(mercator)) * 180.0 / M_PI;
}

static uint8_t mapOverviewZoom()
{
    return static_cast<uint8_t>(constrain(
        14,
        static_cast<int>(BFWATCH_MAP_MIN_ZOOM),
        static_cast<int>(BFWATCH_MAP_MAX_ZOOM)));
}

static bool insideMapDetail(double latitude, double longitude)
{
    return !BFWATCH_MAP_HAS_DETAIL_BOUNDS ||
           (latitude >= BFWATCH_MAP_DETAIL_SOUTH &&
            latitude <= BFWATCH_MAP_DETAIL_NORTH &&
            longitude >= BFWATCH_MAP_DETAIL_WEST &&
            longitude <= BFWATCH_MAP_DETAIL_EAST);
}

static void clampMapCenter()
{
    const bool useDetail =
        BFWATCH_MAP_HAS_DETAIL_BOUNDS &&
        mapZoom == BFWATCH_MAP_DETAIL_ZOOM;
    const double west =
        useDetail ? BFWATCH_MAP_DETAIL_WEST : BFWATCH_MAP_WEST;
    const double south =
        useDetail ? BFWATCH_MAP_DETAIL_SOUTH : BFWATCH_MAP_SOUTH;
    const double east =
        useDetail ? BFWATCH_MAP_DETAIL_EAST : BFWATCH_MAP_EAST;
    const double north =
        useDetail ? BFWATCH_MAP_DETAIL_NORTH : BFWATCH_MAP_NORTH;

    const double westernX = longitudeToWorldX(west, mapZoom);
    const double easternX = longitudeToWorldX(east, mapZoom);
    const double northernY = latitudeToWorldY(north, mapZoom);
    const double southernY = latitudeToWorldY(south, mapZoom);

    double worldX = longitudeToWorldX(mapCenterLongitude, mapZoom);
    double worldY = latitudeToWorldY(mapCenterLatitude, mapZoom);
    // Clamp the chosen centre to the installed geographic area, rather than
    // requiring the entire 240px viewport to remain inside it. The previous
    // viewport-sized inset made wide strain maps appear to snap back because
    // some zoom levels allowed only a few pixels of centre movement.
    worldX = max(westernX, min(easternX, worldX));
    worldY = max(northernY, min(southernY, worldY));
    mapCenterLongitude = worldXToLongitude(worldX, mapZoom);
    mapCenterLatitude = worldYToLatitude(worldY, mapZoom);
}

static void resetMapCenter()
{
    if (haveFix && insideAmsterdam(lastLatitude, lastLongitude)) {
        if (BFWATCH_MAP_HAS_DETAIL_BOUNDS &&
            mapZoom == BFWATCH_MAP_DETAIL_ZOOM &&
            !insideMapDetail(lastLatitude, lastLongitude) &&
            mapZoom > BFWATCH_MAP_MIN_ZOOM) {
            --mapZoom;
        }
        mapCenterLatitude = lastLatitude;
        mapCenterLongitude = lastLongitude;
        mapFollowPosition = true;
    } else {
        mapCenterLatitude =
            BFWATCH_DEFAULT_LATITUDE_E6 / 1000000.0;
        mapCenterLongitude =
            BFWATCH_DEFAULT_LONGITUDE_E6 / 1000000.0;
        mapFollowPosition = false;
    }
    clampMapCenter();
    mapCenterInitialized = true;
}

static void focusMapOnCurrentLocation()
{
    if (!haveFix || !insideAmsterdam(lastLatitude, lastLongitude)) {
        return;
    }
    mapZoom = BFWATCH_MAP_MAX_ZOOM;
    if (BFWATCH_MAP_HAS_DETAIL_BOUNDS &&
        mapZoom == BFWATCH_MAP_DETAIL_ZOOM &&
        !insideMapDetail(lastLatitude, lastLongitude) &&
        mapZoom > BFWATCH_MAP_MIN_ZOOM) {
        --mapZoom;
    }
    mapCenterLatitude = lastLatitude;
    mapCenterLongitude = lastLongitude;
    mapFollowPosition = true;
    mapFocusedShopIndex = -1;
    clampMapCenter();
    mapCenterInitialized = true;
}

static void openOverviewMap()
{
    mapStrainFilterActive = false;
    mapFilteredStockistCount = 0;
    mapZoom = mapOverviewZoom();
    mapCenterLatitude =
        BFWATCH_DEFAULT_LATITUDE_E6 / 1000000.0;
    mapCenterLongitude =
        BFWATCH_DEFAULT_LONGITUDE_E6 / 1000000.0;
    mapFollowPosition = false;
    mapFocusedShopIndex = -1;
    clampMapCenter();
    mapCenterInitialized = true;
    currentView = View::MAP;
    buildCurrentView();
}

static void openSelectedStrainMap()
{
    if (selectedStrainName[0] == '\0') {
        currentView = View::STRAINS;
        buildCurrentView();
        return;
    }
    mapStrainFilterActive = true;
    mapFilteredStockistCount = 0;
    double minimumLatitude = 90.0;
    double maximumLatitude = -90.0;
    double minimumLongitude = 180.0;
    double maximumLongitude = -180.0;
    for (size_t index = 0; index < BFWATCH_SHOP_COUNT; ++index) {
        if (!shopStocksStrain(index, selectedStrainName)) {
            continue;
        }
        double latitude = 0.0;
        double longitude = 0.0;
        shopCoordinates(index, latitude, longitude);
        minimumLatitude = min(minimumLatitude, latitude);
        maximumLatitude = max(maximumLatitude, latitude);
        minimumLongitude = min(minimumLongitude, longitude);
        maximumLongitude = max(maximumLongitude, longitude);
        ++mapFilteredStockistCount;
    }
    if (mapFilteredStockistCount > 0) {
        // Z16 is a deliberately cropped central-city detail layer. Strain
        // maps start no closer than Z15 so a stockist near that crop's edge
        // cannot be pushed underneath the fixed map controls.
        uint8_t highestZoom = min(
            static_cast<uint8_t>(15), BFWATCH_MAP_MAX_ZOOM);
        if (BFWATCH_MAP_HAS_DETAIL_BOUNDS &&
            highestZoom == BFWATCH_MAP_DETAIL_ZOOM &&
            (minimumLatitude < BFWATCH_MAP_DETAIL_SOUTH ||
             maximumLatitude > BFWATCH_MAP_DETAIL_NORTH ||
             minimumLongitude < BFWATCH_MAP_DETAIL_WEST ||
             maximumLongitude > BFWATCH_MAP_DETAIL_EAST) &&
            highestZoom > BFWATCH_MAP_MIN_ZOOM) {
            --highestZoom;
        }

        mapZoom = BFWATCH_MAP_MIN_ZOOM;
        for (int zoom = highestZoom;
             zoom >= static_cast<int>(BFWATCH_MAP_MIN_ZOOM);
             --zoom) {
            mapZoom = static_cast<uint8_t>(zoom);
            const double spanX =
                longitudeToWorldX(maximumLongitude, mapZoom) -
                longitudeToWorldX(minimumLongitude, mapZoom);
            const double spanY =
                latitudeToWorldY(minimumLatitude, mapZoom) -
                latitudeToWorldY(maximumLatitude, mapZoom);
            if (spanX <= STRAIN_MAP_SAFE_HALF_WIDTH * 2.0 &&
                spanY <= STRAIN_MAP_SAFE_HALF_HEIGHT * 2.0) {
                break;
            }
        }

        const double minimumWorldX =
            longitudeToWorldX(minimumLongitude, mapZoom);
        const double maximumWorldX =
            longitudeToWorldX(maximumLongitude, mapZoom);
        const double minimumWorldY =
            latitudeToWorldY(maximumLatitude, mapZoom);
        const double maximumWorldY =
            latitudeToWorldY(minimumLatitude, mapZoom);
        mapCenterLongitude = worldXToLongitude(
            (minimumWorldX + maximumWorldX) * 0.5, mapZoom);
        mapCenterLatitude = worldYToLatitude(
            (minimumWorldY + maximumWorldY) * 0.5, mapZoom);
    } else {
        mapZoom = mapOverviewZoom();
        mapCenterLatitude =
            BFWATCH_DEFAULT_LATITUDE_E6 / 1000000.0;
        mapCenterLongitude =
            BFWATCH_DEFAULT_LONGITUDE_E6 / 1000000.0;
    }
    mapFollowPosition = false;
    mapFocusedShopIndex = -1;
    clampMapCenter();
    mapCenterInitialized = true;
    Serial.printf(
        "Strain map: %s stockists=%u zoom=%u centre=%.6f,%.6f\n",
        selectedStrainName,
        static_cast<unsigned>(mapFilteredStockistCount),
        static_cast<unsigned>(mapZoom),
        mapCenterLatitude, mapCenterLongitude);
    currentView = View::MAP;
    buildCurrentView();
}

static void openShopOnMap(int16_t shopIndex)
{
    if (shopIndex < 0 ||
        shopIndex >= static_cast<int16_t>(BFWATCH_SHOP_COUNT)) {
        return;
    }
    shopCoordinates(
        static_cast<size_t>(shopIndex),
        mapCenterLatitude, mapCenterLongitude);
    mapZoom = BFWATCH_MAP_MAX_ZOOM;
    if (BFWATCH_MAP_HAS_DETAIL_BOUNDS &&
        mapZoom == BFWATCH_MAP_DETAIL_ZOOM &&
        !insideMapDetail(mapCenterLatitude, mapCenterLongitude) &&
        mapZoom > BFWATCH_MAP_MIN_ZOOM) {
        --mapZoom;
    }
    mapFollowPosition = false;
    mapFocusedShopIndex = shopIndex;
    clampMapCenter();
    mapCenterInitialized = true;
    currentView = View::MAP;
    buildCurrentView();
}

static void unloadMapPackIndex()
{
    if (mapPackEntries != nullptr) {
        free(mapPackEntries);
        mapPackEntries = nullptr;
    }
    mapPackEntryCount = 0;
    mapPackFileCount = 0;
}

static bool loadMapPackIndex()
{
    unloadMapPackIndex();
    if (!mapStorageReady || !FFat.exists("/map.idx")) {
        return false;
    }

    File index = FFat.open("/map.idx", FILE_READ);
    MapPackIndexHeader header = {};
    if (!index ||
        index.read(reinterpret_cast<uint8_t *>(&header), sizeof(header)) !=
            sizeof(header) ||
        memcmp(header.magic, "BFMIDX01", sizeof(header.magic)) != 0 ||
        header.tileCount != BFWATCH_MAP_TILE_COUNT ||
        header.packCount == 0 ||
        header.packCount > MAX_MAP_PACK_FILES) {
        index.close();
        return false;
    }

    const size_t entriesSize =
        static_cast<size_t>(header.tileCount) * sizeof(MapPackEntry);
    mapPackEntries =
        static_cast<MapPackEntry *>(ps_malloc(entriesSize));
    if (mapPackEntries == nullptr ||
        index.read(reinterpret_cast<uint8_t *>(mapPackEntries), entriesSize) !=
            entriesSize) {
        index.close();
        unloadMapPackIndex();
        return false;
    }
    index.close();

    for (uint32_t packId = 0; packId < header.packCount; ++packId) {
        char path[16];
        snprintf(path, sizeof(path), "/map%02u.bin",
                 static_cast<unsigned>(packId));
        if (!FFat.exists(path)) {
            unloadMapPackIndex();
            return false;
        }
    }
    for (uint32_t i = 0; i < header.tileCount; ++i) {
        if (mapPackEntries[i].packId >= header.packCount ||
            mapPackEntries[i].size == 0) {
            unloadMapPackIndex();
            return false;
        }
    }

    mapPackEntryCount = header.tileCount;
    mapPackFileCount = header.packCount;
    return true;
}

static const MapPackEntry *findMapPackEntry(
    uint8_t zoom, int32_t x, int32_t y)
{
    int32_t low = 0;
    int32_t high = static_cast<int32_t>(mapPackEntryCount) - 1;
    while (low <= high) {
        const int32_t middle = low + (high - low) / 2;
        const MapPackEntry &entry = mapPackEntries[middle];
        int comparison = static_cast<int>(zoom) -
                         static_cast<int>(entry.zoom);
        if (comparison == 0 && x != entry.x) {
            comparison = x < entry.x ? -1 : 1;
        }
        if (comparison == 0 && y != entry.y) {
            comparison = y < entry.y ? -1 : 1;
        }
        if (comparison == 0) {
            return &entry;
        }
        if (comparison < 0) {
            high = middle - 1;
        } else {
            low = middle + 1;
        }
    }
    return nullptr;
}

static bool mapFilesInstalled()
{
    return loadMapPackIndex();
}

static void unloadLogoIndex()
{
    if (logoIndexRecords != nullptr) {
        free(logoIndexRecords);
        logoIndexRecords = nullptr;
    }
    // Keep the PSRAM allocation so any currently displayed canvases retain a
    // valid backing store while a replacement logo package is uploaded.
    menuLogoBufferReady = false;
    logoIndexRecordCount = 0;
}

static bool loadLogoIndex()
{
    unloadLogoIndex();
    if (!mapStorageReady ||
        !FFat.exists("/logos.idx") ||
        !FFat.exists("/logos.bin")) {
        return false;
    }

    File index = FFat.open("/logos.idx", FILE_READ);
    LogoIndexHeader header = {};
    if (!index ||
        index.read(reinterpret_cast<uint8_t *>(&header), sizeof(header)) !=
            sizeof(header) ||
        memcmp(header.magic, "BFLGIDX1", sizeof(header.magic)) != 0 ||
        header.width != BFWATCH_LOGO_WIDTH ||
        header.height != BFWATCH_LOGO_HEIGHT ||
        header.shopCount != BFWATCH_LOGO_SHOP_COUNT ||
        header.shopCount != BFWATCH_SHOP_COUNT ||
        header.dataBytes != BFWATCH_LOGO_DATA_BYTES ||
        header.dataCrc32 != BFWATCH_LOGO_DATA_CRC32) {
        index.close();
        return false;
    }

    File data = FFat.open("/logos.bin", FILE_READ);
    const bool dataValid = data && data.size() == header.dataBytes;
    data.close();
    if (!dataValid) {
        index.close();
        return false;
    }

    const size_t recordsSize =
        static_cast<size_t>(header.shopCount) * sizeof(LogoIndexRecord);
    logoIndexRecords =
        static_cast<LogoIndexRecord *>(ps_malloc(recordsSize));
    if (logoIndexRecords == nullptr ||
        index.read(reinterpret_cast<uint8_t *>(logoIndexRecords),
                   recordsSize) != recordsSize) {
        index.close();
        unloadLogoIndex();
        return false;
    }
    index.close();

    const uint32_t spriteBytes =
        static_cast<uint32_t>(header.width) * header.height * 4U;
    uint32_t previousHash = 0;
    for (uint32_t i = 0; i < header.shopCount; ++i) {
        const LogoIndexRecord &record = logoIndexRecords[i];
        if ((i > 0 && record.identifierHash <= previousHash) ||
            record.offset > header.dataBytes ||
            spriteBytes > header.dataBytes - record.offset) {
            unloadLogoIndex();
            return false;
        }
        previousHash = record.identifierHash;
    }
    logoIndexRecordCount = header.shopCount;
    return true;
}

static int32_t findLogoRecordIndex(uint32_t identifierHash)
{
    int32_t low = 0;
    int32_t high = static_cast<int32_t>(logoIndexRecordCount) - 1;
    while (low <= high) {
        const int32_t middle = low + (high - low) / 2;
        const uint32_t candidate =
            logoIndexRecords[middle].identifierHash;
        if (candidate == identifierHash) {
            return middle;
        }
        if (identifierHash < candidate) {
            high = middle - 1;
        } else {
            low = middle + 1;
        }
    }
    return -1;
}

static void unloadMenuPackage()
{
    unloadStrainCatalog();
    if (menuPackageBuffer != nullptr) {
        free(menuPackageBuffer);
        menuPackageBuffer = nullptr;
    }
    externalMenuShops = nullptr;
    externalMenuStrains = nullptr;
    externalMenuStrings = nullptr;
    externalMenuShopCount = 0;
    externalMenuStrainCount = 0;
    externalMenuStringBytes = 0;
    menuPackageReady = false;
}

static int32_t findExternalMenuRecord(uint32_t identifierHash)
{
    int32_t low = 0;
    int32_t high = static_cast<int32_t>(externalMenuShopCount) - 1;
    while (low <= high) {
        const int32_t middle = low + (high - low) / 2;
        const uint32_t candidate =
            externalMenuShops[middle].identifierHash;
        if (candidate == identifierHash) {
            return middle;
        }
        if (identifierHash < candidate) {
            high = middle - 1;
        } else {
            low = middle + 1;
        }
    }
    return -1;
}

static bool loadMenuPackage()
{
    unloadMenuPackage();
    if (!mapStorageReady || !FFat.exists("/menus.bin")) {
        return false;
    }

    File file = FFat.open("/menus.bin", FILE_READ);
    ExternalMenuHeader header = {};
    if (!file ||
        file.read(reinterpret_cast<uint8_t *>(&header), sizeof(header)) !=
            sizeof(header) ||
        memcmp(header.magic, "BFMENU01", sizeof(header.magic)) != 0 ||
        header.shopCount != BFWATCH_SHOP_COUNT ||
        header.strainCount > 65535 ||
        header.stringBytes == 0 || header.stringBytes > 1024 * 1024) {
        file.close();
        return false;
    }

    const size_t shopBytes =
        static_cast<size_t>(header.shopCount) *
        sizeof(ExternalMenuShopRecord);
    const size_t strainBytes =
        static_cast<size_t>(header.strainCount) *
        sizeof(ExternalMenuStrainRecord);
    const size_t expectedPayload =
        shopBytes + strainBytes + header.stringBytes;
    if (header.payloadBytes != expectedPayload ||
        static_cast<size_t>(file.size()) !=
            sizeof(header) + expectedPayload) {
        file.close();
        return false;
    }

    menuPackageBuffer = static_cast<uint8_t *>(ps_malloc(expectedPayload));
    if (menuPackageBuffer == nullptr ||
        file.read(menuPackageBuffer, expectedPayload) != expectedPayload) {
        file.close();
        unloadMenuPackage();
        return false;
    }
    file.close();
    const uint32_t crc =
        updateCrc32(0xFFFFFFFFUL, menuPackageBuffer, expectedPayload) ^
        0xFFFFFFFFUL;
    if (crc != header.payloadCrc32) {
        unloadMenuPackage();
        return false;
    }

    externalMenuShops =
        reinterpret_cast<ExternalMenuShopRecord *>(menuPackageBuffer);
    externalMenuStrains = reinterpret_cast<ExternalMenuStrainRecord *>(
        menuPackageBuffer + shopBytes);
    externalMenuStrings = reinterpret_cast<char *>(
        menuPackageBuffer + shopBytes + strainBytes);
    externalMenuShopCount = header.shopCount;
    externalMenuStrainCount = header.strainCount;
    externalMenuStringBytes = header.stringBytes;

    uint32_t previousHash = 0;
    for (uint32_t index = 0; index < externalMenuShopCount; ++index) {
        const ExternalMenuShopRecord &shop = externalMenuShops[index];
        if ((index > 0 && shop.identifierHash <= previousHash) ||
            shop.strainOffset > externalMenuStrainCount ||
            shop.strainCount >
                externalMenuStrainCount - shop.strainOffset ||
            shop.strainCount != shop.menuTotal) {
            unloadMenuPackage();
            return false;
        }
        previousHash = shop.identifierHash;
    }
    for (size_t index = 0; index < BFWATCH_SHOP_COUNT; ++index) {
        if (findExternalMenuRecord(shopIdentifierHash(index)) < 0) {
            unloadMenuPackage();
            return false;
        }
    }
    for (uint32_t index = 0; index < externalMenuStrainCount; ++index) {
        const uint32_t offset = externalMenuStrains[index].nameOffset;
        if (offset >= externalMenuStringBytes ||
            memchr(externalMenuStrings + offset, '\0',
                   externalMenuStringBytes - offset) == nullptr) {
            unloadMenuPackage();
            return false;
        }
    }
    menuPackageReady = true;
    return true;
}

static const ExternalMenuShopRecord *externalMenuForShop(size_t shopIndex)
{
    if (!menuPackageReady || shopIndex >= BFWATCH_SHOP_COUNT) {
        return nullptr;
    }
    const int32_t record =
        findExternalMenuRecord(shopIdentifierHash(shopIndex));
    return record >= 0 ? &externalMenuShops[record] : nullptr;
}

static void shopMenuCounts(
    size_t shopIndex, uint16_t &menuTotal, uint16_t &strainCount)
{
    const ExternalMenuShopRecord *external =
        externalMenuForShop(shopIndex);
    if (external != nullptr) {
        menuTotal = external->menuTotal;
        strainCount = external->strainCount;
        return;
    }
    const WatchShopRecord &compiled = BFWATCH_SHOPS[shopIndex];
    menuTotal = compiled.menuTotal;
    strainCount = compiled.strainCount;
}

static bool shopMenuStrain(
    size_t shopIndex, uint16_t position, MenuStrainView &result)
{
    const ExternalMenuShopRecord *external =
        externalMenuForShop(shopIndex);
    if (external != nullptr) {
        if (position >= external->strainCount) {
            return false;
        }
        const ExternalMenuStrainRecord &strain =
            externalMenuStrains[external->strainOffset + position];
        result = {
            externalMenuStrings + strain.nameOffset,
            strain.priceCents,
            strain.type,
            strain.flags,
        };
        return true;
    }

    const WatchShopRecord &shop = BFWATCH_SHOPS[shopIndex];
    if (position >= shop.strainCount) {
        return false;
    }
    const WatchStrainRecord &strain =
        BFWATCH_STRAINS[shop.strainOffset + position];
    result = {
        bfwatchString(strain.nameOffset),
        strain.priceCents,
        strain.type,
        strain.flags,
    };
    return true;
}

static void unloadStrainCatalog()
{
    if (strainCatalogNames != nullptr) {
        free(strainCatalogNames);
        strainCatalogNames = nullptr;
    }
    strainCatalogCount = 0;
    strainLetterOpen = false;
    strainFavouritesOpen = false;
    strainActiveLetter = 0;
    strainsScrollOffset = 0;
    strainShopsScrollOffset = 0;
    strainShopCount = 0;
}

static int compareStrainCatalogNames(const void *left, const void *right)
{
    const char *leftName =
        *static_cast<const char *const *>(left);
    const char *rightName =
        *static_cast<const char *const *>(right);
    return strcasecmp(leftName, rightName);
}

static uint8_t alphabetBucket(const char *name)
{
    if (name == nullptr) {
        return ALPHABET_OTHER_BUCKET;
    }
    while (*name != '\0' &&
           isspace(static_cast<unsigned char>(*name))) {
        ++name;
    }
    const int first = toupper(static_cast<unsigned char>(*name));
    return first >= 'A' && first <= 'Z'
        ? static_cast<uint8_t>(first - 'A')
        : ALPHABET_OTHER_BUCKET;
}

static bool buildStrainCatalog()
{
    if (strainCatalogNames != nullptr) {
        return true;
    }
    // Search must never claim completeness from the compact compiled fallback.
    if (!menuPackageReady || externalMenuStrainCount == 0) {
        return false;
    }

    const size_t bytes =
        static_cast<size_t>(externalMenuStrainCount) *
        sizeof(*strainCatalogNames);
    strainCatalogNames =
        static_cast<const char **>(ps_malloc(bytes));
    if (strainCatalogNames == nullptr) {
        return false;
    }

    uint32_t count = 0;
    for (size_t shopIndex = 0;
         shopIndex < BFWATCH_SHOP_COUNT; ++shopIndex) {
        uint16_t menuTotal = 0;
        uint16_t strainCount = 0;
        shopMenuCounts(shopIndex, menuTotal, strainCount);
        for (uint16_t position = 0; position < strainCount; ++position) {
            MenuStrainView strain = {};
            if (shopMenuStrain(shopIndex, position, strain) &&
                strain.name != nullptr && strain.name[0] != '\0') {
                strainCatalogNames[count++] = strain.name;
            }
        }
    }
    if (count != externalMenuStrainCount) {
        unloadStrainCatalog();
        return false;
    }

    qsort(strainCatalogNames, count, sizeof(*strainCatalogNames),
          compareStrainCatalogNames);
    uint32_t uniqueCount = 0;
    for (uint32_t index = 0; index < count; ++index) {
        if (uniqueCount == 0 ||
            strcasecmp(strainCatalogNames[index],
                       strainCatalogNames[uniqueCount - 1]) != 0) {
            strainCatalogNames[uniqueCount++] =
                strainCatalogNames[index];
        }
    }
    strainCatalogCount = uniqueCount;
    if (selectedStrainName[0] != '\0') {
        for (uint32_t index = 0; index < strainCatalogCount; ++index) {
            if (strcasecmp(
                    strainCatalogNames[index], selectedStrainName) == 0) {
                strainActiveLetter =
                    alphabetBucket(strainCatalogNames[index]);
                break;
            }
        }
    }
    return strainCatalogCount > 0;
}

static bool shopStrainOffer(
    size_t shopIndex, const char *strainName, MenuStrainView &result)
{
    if (strainName == nullptr || strainName[0] == '\0') {
        return false;
    }
    uint16_t menuTotal = 0;
    uint16_t strainCount = 0;
    shopMenuCounts(shopIndex, menuTotal, strainCount);
    for (uint16_t position = 0; position < strainCount; ++position) {
        MenuStrainView strain = {};
        if (shopMenuStrain(shopIndex, position, strain) &&
            strcasecmp(strain.name, strainName) == 0) {
            result = strain;
            return true;
        }
    }
    return false;
}

static bool shopStocksStrain(size_t shopIndex, const char *strainName)
{
    MenuStrainView ignored = {};
    return shopStrainOffer(shopIndex, strainName, ignored);
}

static void rebuildStrainShopOrder()
{
    strainShopCount = 0;
    if (selectedStrainName[0] == '\0') {
        return;
    }
    for (size_t index = 0; index < BFWATCH_SHOP_COUNT; ++index) {
        if (shopStocksStrain(index, selectedStrainName)) {
            strainShopOrder[strainShopCount++] =
                static_cast<uint16_t>(index);
        }
    }
    for (size_t index = 1; index < strainShopCount; ++index) {
        const uint16_t value = strainShopOrder[index];
        size_t position = index;
        while (position > 0 &&
               shopComesBefore(value, strainShopOrder[position - 1])) {
            strainShopOrder[position] =
                strainShopOrder[position - 1];
            --position;
        }
        strainShopOrder[position] = value;
    }
}

static bool mapPackFsReady(lv_fs_drv_t *driver)
{
    (void)driver;
    return mapStorageReady && mapPackEntries != nullptr;
}

static void *mapPackFsOpen(
    lv_fs_drv_t *driver, const char *path, lv_fs_mode_t mode)
{
    (void)driver;
    if (!(mode & LV_FS_MODE_RD) || mapPackEntries == nullptr) {
        return nullptr;
    }

    while (*path == '/') {
        ++path;
    }
    unsigned zoom = 0;
    long x = 0;
    long y = 0;
    int consumed = 0;
    if (sscanf(path, "%u/%ld/%ld.jpg%n",
               &zoom, &x, &y, &consumed) != 3 ||
        path[consumed] != '\0' || zoom > UINT8_MAX) {
        return nullptr;
    }
    const MapPackEntry *entry = findMapPackEntry(
        static_cast<uint8_t>(zoom),
        static_cast<int32_t>(x),
        static_cast<int32_t>(y));
    if (entry == nullptr) {
        return nullptr;
    }

    MapPackedFile *handle = new MapPackedFile();
    if (handle == nullptr) {
        return nullptr;
    }
    char packPath[16];
    snprintf(packPath, sizeof(packPath), "/map%02u.bin",
             static_cast<unsigned>(entry->packId));
    handle->file = FFat.open(packPath, FILE_READ);
    handle->base = entry->offset;
    handle->size = entry->size;
    handle->position = 0;
    if (!handle->file || !handle->file.seek(handle->base)) {
        handle->file.close();
        delete handle;
        return nullptr;
    }
    return handle;
}

static lv_fs_res_t mapPackFsClose(lv_fs_drv_t *driver, void *filePointer)
{
    (void)driver;
    MapPackedFile *handle = static_cast<MapPackedFile *>(filePointer);
    if (handle == nullptr) {
        return LV_FS_RES_INV_PARAM;
    }
    handle->file.close();
    delete handle;
    return LV_FS_RES_OK;
}

static lv_fs_res_t mapPackFsRead(
    lv_fs_drv_t *driver, void *filePointer, void *buffer,
    uint32_t bytesToRead, uint32_t *bytesRead)
{
    (void)driver;
    MapPackedFile *handle = static_cast<MapPackedFile *>(filePointer);
    if (handle == nullptr || buffer == nullptr) {
        return LV_FS_RES_INV_PARAM;
    }
    const uint32_t remaining = handle->size - handle->position;
    const uint32_t requested = min(bytesToRead, remaining);
    if (!handle->file.seek(handle->base + handle->position)) {
        return LV_FS_RES_FS_ERR;
    }
    const size_t count = handle->file.read(
        static_cast<uint8_t *>(buffer), requested);
    handle->position += count;
    if (bytesRead != nullptr) {
        *bytesRead = count;
    }
    return count == requested ? LV_FS_RES_OK : LV_FS_RES_FS_ERR;
}

static lv_fs_res_t mapPackFsSeek(
    lv_fs_drv_t *driver, void *filePointer, uint32_t position,
    lv_fs_whence_t whence)
{
    (void)driver;
    MapPackedFile *handle = static_cast<MapPackedFile *>(filePointer);
    if (handle == nullptr) {
        return LV_FS_RES_INV_PARAM;
    }
    uint64_t target = position;
    if (whence == LV_FS_SEEK_CUR) {
        target += handle->position;
    } else if (whence == LV_FS_SEEK_END) {
        target += handle->size;
    }
    if (target > handle->size) {
        return LV_FS_RES_INV_PARAM;
    }
    handle->position = static_cast<uint32_t>(target);
    return LV_FS_RES_OK;
}

static lv_fs_res_t mapPackFsTell(
    lv_fs_drv_t *driver, void *filePointer, uint32_t *position)
{
    (void)driver;
    MapPackedFile *handle = static_cast<MapPackedFile *>(filePointer);
    if (handle == nullptr || position == nullptr) {
        return LV_FS_RES_INV_PARAM;
    }
    *position = handle->position;
    return LV_FS_RES_OK;
}

static void registerMapPackFileSystem()
{
    lv_fs_drv_init(&mapPackFsDriver);
    mapPackFsDriver.letter = 'P';
    mapPackFsDriver.ready_cb = mapPackFsReady;
    mapPackFsDriver.open_cb = mapPackFsOpen;
    mapPackFsDriver.close_cb = mapPackFsClose;
    mapPackFsDriver.read_cb = mapPackFsRead;
    mapPackFsDriver.seek_cb = mapPackFsSeek;
    mapPackFsDriver.tell_cb = mapPackFsTell;
    lv_fs_drv_register(&mapPackFsDriver);
}

