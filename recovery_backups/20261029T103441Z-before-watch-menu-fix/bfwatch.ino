static bool rotateWatchFaceShop(bool force)
{
    if (BFWATCH_SHOP_COUNT == 0) {
        rotatingWatchShopIndex = -1;
        rotatingWatchShopChangedMs = 0;
        return false;
    }

    const uint32_t now = millis();
    if (watchShopMode == WatchShopMode::NEAREST && haveNearest) {
        const bool changed =
            rotatingWatchShopIndex != nearestShopIndex;
        rotatingWatchShopIndex = nearestShopIndex;
        rotatingWatchShopChangedMs = now;
        return changed;
    }

    if (!force && rotatingWatchShopIndex >= 0 &&
        now - rotatingWatchShopChangedMs <
            RANDOM_WATCH_SHOP_INTERVAL_MS) {
        return false;
    }

    size_t favouriteCount = 0;
    if (watchShopMode == WatchShopMode::FAVOURITES) {
        for (size_t index = 0; index < BFWATCH_SHOP_COUNT; ++index) {
            if (isShopFavourite(index)) {
                ++favouriteCount;
            }
        }
    }
    const bool useFavouritePool =
        watchShopMode == WatchShopMode::FAVOURITES &&
        favouriteCount > 0;
    const size_t eligibleCount =
        useFavouritePool ? favouriteCount : BFWATCH_SHOP_COUNT;

    size_t wanted = esp_random() % eligibleCount;
    int16_t next = -1;
    for (size_t index = 0; index < BFWATCH_SHOP_COUNT; ++index) {
        if (useFavouritePool && !isShopFavourite(index)) {
            continue;
        }
        if (wanted-- == 0) {
            next = static_cast<int16_t>(index);
            break;
        }
    }
    if (next < 0) {
        next = static_cast<int16_t>(
            esp_random() % BFWATCH_SHOP_COUNT);
    }

    if (eligibleCount > 1 && next == rotatingWatchShopIndex) {
        for (size_t offset = 1; offset < BFWATCH_SHOP_COUNT; ++offset) {
            const size_t candidate =
                (static_cast<size_t>(next) + offset) %
                BFWATCH_SHOP_COUNT;
            if (!useFavouritePool || isShopFavourite(candidate)) {
                next = static_cast<int16_t>(candidate);
                break;
            }
        }
    }
    const bool changed = next != rotatingWatchShopIndex;
    rotatingWatchShopIndex = next;
    rotatingWatchShopChangedMs = now;
    return changed;
}

static int16_t watchFaceShopIndex()
{
    return rotatingWatchShopIndex;
}

static bool addShopLogoToWatchFace(int16_t shopIndex)
{
    if (shopIndex < 0 ||
        shopIndex >= static_cast<int16_t>(BFWATCH_SHOP_COUNT) ||
        !logoPackageReady) {
        return false;
    }
    const int32_t recordIndex = findLogoRecordIndex(
        shopIdentifierHash(static_cast<size_t>(shopIndex)));
    if (recordIndex < 0) {
        return false;
    }

    const size_t spriteBytes =
        static_cast<size_t>(BFWATCH_LOGO_WIDTH) *
        BFWATCH_LOGO_HEIGHT * sizeof(lv_color32_t);
    if (mapLogoSpriteBuffer == nullptr) {
        mapLogoSpriteBuffer =
            static_cast<uint8_t *>(ps_malloc(spriteBytes));
    }
    if (mapLogoSpriteBuffer == nullptr) {
        return false;
    }

    File logoData = FFat.open("/logos.bin", FILE_READ);
    const LogoIndexRecord &record = logoIndexRecords[recordIndex];
    const bool loaded =
        logoData && logoData.seek(record.offset) &&
        logoData.read(mapLogoSpriteBuffer, spriteBytes) == spriteBytes;
    logoData.close();
    if (!loaded) {
        return false;
    }

    lv_obj_t *canvas = lv_canvas_create(lv_scr_act());
    lv_canvas_set_buffer(
        canvas, mapLogoSpriteBuffer,
        BFWATCH_LOGO_WIDTH, BFWATCH_LOGO_HEIGHT,
        LV_COLOR_FORMAT_ARGB8888);
    lv_obj_set_pos(
        canvas,
        16 + (48 - static_cast<int16_t>(BFWATCH_LOGO_WIDTH)) / 2,
        159 + (48 - static_cast<int16_t>(BFWATCH_LOGO_HEIGHT)) / 2);
    lv_obj_clear_flag(canvas, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_clear_flag(canvas, LV_OBJ_FLAG_SCROLLABLE);
    return true;
}

