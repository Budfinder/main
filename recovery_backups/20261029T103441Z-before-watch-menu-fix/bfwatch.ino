static void listScrollEvent(lv_event_t *event)
{
    const lv_event_code_t code = lv_event_get_code(event);
    if (code != LV_EVENT_SCROLL_BEGIN &&
        code != LV_EVENT_SCROLL &&
        code != LV_EVENT_SCROLL_END) {
        return;
    }
    int32_t *savedOffset = static_cast<int32_t *>(
        lv_event_get_user_data(event));
    lv_obj_t *frame = static_cast<lv_obj_t *>(
        lv_event_get_current_target(event));
    if (savedOffset != nullptr && frame != nullptr) {
        *savedOffset = max(0L, lv_obj_get_scroll_y(frame));
    }
    markActivity();
}

static void captureActiveListPosition()
{
    if (activeListFrame == nullptr ||
        activeListSavedOffset == nullptr) {
        return;
    }
    *activeListSavedOffset =
        max(0L, lv_obj_get_scroll_y(activeListFrame));
}

static void finishActiveListLayout()
{
    if (activeListFrame == nullptr) {
        return;
    }

    // The content is populated after makeVerticalList() returns. Restoring
    // before those children exist lets LVGL clamp the offset back to zero,
    // which is why returning from Torch reopened BUD//APPS at the top.
    lv_obj_update_layout(lv_scr_act());
    lv_obj_scroll_to_y(
        activeListFrame, activeListRestoreOffset, LV_ANIM_OFF);
    lv_obj_add_event_cb(
        activeListFrame, listScrollEvent, LV_EVENT_ALL,
        activeListSavedOffset);
    if (activeListSavedOffset != nullptr) {
        *activeListSavedOffset =
            max(0L, lv_obj_get_scroll_y(activeListFrame));
    }
}

static lv_obj_t *makeVerticalList(
    int16_t x, int16_t y, int16_t width, int16_t height,
    int32_t contentHeight, int32_t *savedOffset)
{
    lv_obj_t *frame = lv_obj_create(lv_scr_act());
    lv_obj_set_pos(frame, x, y);
    lv_obj_set_size(frame, width, height);
    lv_obj_set_style_radius(frame, 13, 0);
    lv_obj_set_style_bg_color(frame, lv_color_hex(THEME_PANEL), 0);
    lv_obj_set_style_bg_opa(frame, LV_OPA_COVER, 0);
    lv_obj_set_style_border_color(frame, lv_color_hex(THEME_BORDER), 0);
    lv_obj_set_style_border_width(frame, 1, 0);
    lv_obj_set_style_pad_all(frame, 0, 0);
    lv_obj_clear_flag(frame, LV_OBJ_FLAG_OVERFLOW_VISIBLE);
    lv_obj_add_flag(frame, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_flag(frame, LV_OBJ_FLAG_SCROLL_MOMENTUM);
    lv_obj_add_flag(frame, LV_OBJ_FLAG_GESTURE_BUBBLE);
    lv_obj_remove_flag(frame, LV_OBJ_FLAG_SCROLL_ELASTIC);
    lv_obj_remove_flag(frame, LV_OBJ_FLAG_SCROLL_CHAIN_HOR);
    lv_obj_remove_flag(frame, LV_OBJ_FLAG_SCROLL_CHAIN_VER);
    lv_obj_set_scroll_dir(frame, LV_DIR_VER);
    lv_obj_set_scrollbar_mode(frame, LV_SCROLLBAR_MODE_OFF);

    const int16_t contentWidth = width - 2;
    const int32_t actualContentHeight =
        max(static_cast<int32_t>(height - 2), contentHeight);
    lv_obj_t *content = lv_obj_create(frame);
    lv_obj_remove_style_all(content);
    lv_obj_set_pos(content, 0, 0);
    lv_obj_set_size(
        content, contentWidth, actualContentHeight);
    lv_obj_clear_flag(content, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_clear_flag(content, LV_OBJ_FLAG_OVERFLOW_VISIBLE);
    lv_obj_add_flag(content, LV_OBJ_FLAG_GESTURE_BUBBLE);

    const int32_t maximumOffset =
        max(0L, actualContentHeight - static_cast<int32_t>(height - 2));
    const int32_t restoredOffset = savedOffset == nullptr
        ? 0
        : constrain(*savedOffset, 0L, maximumOffset);
    if (savedOffset != nullptr) {
        *savedOffset = restoredOffset;
    }
    activeListFrame = frame;
    activeListSavedOffset = savedOffset;
    activeListRestoreOffset = restoredOffset;
    return content;
}

static void prepareScreen()
{
    // Capture the final native-scroll position before LVGL destroys the
    // current screen. This also catches navigation during scroll momentum,
    // when a final LV_EVENT_SCROLL_END may not have fired yet.
    captureActiveListPosition();
    lv_obj_t *screen = lv_scr_act();
    lv_obj_clean(screen);
    activeListFrame = nullptr;
    activeListSavedOffset = nullptr;
    activeListRestoreOffset = 0;
    lv_obj_set_style_bg_color(screen, lv_color_hex(THEME_BACKGROUND), 0);
    lv_obj_set_style_bg_opa(screen, LV_OPA_COVER, 0);
    lv_obj_set_style_border_width(screen, 0, 0);
    lv_obj_clear_flag(screen, LV_OBJ_FLAG_SCROLLABLE);
    if (!screenGestureInstalled) {
        lv_obj_add_event_cb(screen, gestureEvent, LV_EVENT_GESTURE, nullptr);
        screenGestureInstalled = true;
    }

    if (currentView != View::MAP && currentView != View::TORCH) {
        lv_obj_t *background = lv_image_create(screen);
        lv_image_set_src(background, &BFWATCH_WATCHFACE_BACKGROUND);
        lv_obj_set_pos(background, 0, 0);
        lv_obj_clear_flag(background, LV_OBJ_FLAG_CLICKABLE);
        lv_obj_clear_flag(background, LV_OBJ_FLAG_SCROLLABLE);
    }

    primaryLabel = nullptr;
    secondaryLabel = nullptr;
    tertiaryLabel = nullptr;
    shopDistanceLabel = nullptr;
    batteryLabel = nullptr;
    runningAppsLabel = nullptr;
    audioTestButtonLabel = nullptr;
    statusLabel = nullptr;
}

