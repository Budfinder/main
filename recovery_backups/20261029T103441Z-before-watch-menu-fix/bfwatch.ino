static void updateGpsView()
{
    setLabel(primaryLabel, gpsStatus);

    char detail[128];
    if (gpsAcquiring) {
        const uint32_t seconds = (millis() - gpsStartedMs) / 1000U;
        const uint32_t timeoutSeconds =
            (gpsManualRequest
                ? GPS_MANUAL_TIMEOUT_MS
                : GPS_AUTO_TIMEOUT_MS) / 1000U;
        const uint32_t satellites = instance.gps.satellites.isValid() ?
                                    instance.gps.satellites.value() : 0;
        const uint32_t nmeaSentences =
            instance.gps.passedChecksum();
        const bool receiverData =
            instance.gps.charsProcessed() > gpsCharsAtStart + 20U;
        snprintf(
            detail, sizeof(detail),
            "Searching %us / %us  SAT %u\nReceiver: %s  NMEA %lu",
            seconds, timeoutSeconds, satellites,
            receiverData ? "DATA OK" : "WAITING",
            static_cast<unsigned long>(nmeaSentences));
    } else if (haveFix) {
        if (haveNearest) {
            char distance[24];
            formatDistance(nearestDistanceM, distance, sizeof(distance));
            snprintf(detail, sizeof(detail),
                     "%.5f, %.5f\nNearest%s: %s\n%s %s",
                     lastLatitude, lastLongitude,
                     insideAmsterdam(lastLatitude, lastLongitude) ? "" : " in Amsterdam",
                     nearestName, distance,
                     cardinalDirection(nearestBearingDeg));
        } else {
            snprintf(detail, sizeof(detail), "%.5f, %.5f\nGNSS powered off",
                     lastLatitude, lastLongitude);
        }
    } else {
        snprintf(detail, sizeof(detail), "GNSS powered off");
    }
    setLabel(secondaryLabel, detail);
}

