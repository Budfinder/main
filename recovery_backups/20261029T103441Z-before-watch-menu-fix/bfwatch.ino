static void stopJokeAccessPoint()
{
    if (jokeApActive) {
        WiFi.softAPdisconnect(true);
    }
    WiFi.mode(WIFI_OFF);
    jokeApActive = false;
    activeJokeSsid = nullptr;
    jokeApStartedMs = 0;
    updateCurrentView(true);
}

static void startJokeAccessPoint(size_t index)
{
    if (index >= JOKE_SSID_COUNT) {
        return;
    }
    if (jokeApActive) {
        WiFi.softAPdisconnect(true);
    }
    WiFi.mode(WIFI_AP);
    if (!WiFi.softAP(JOKE_SSIDS[index])) {
        WiFi.mode(WIFI_OFF);
        jokeApActive = false;
        activeJokeSsid = nullptr;
        setLabel(statusLabel, "Could not start Wi-Fi");
        return;
    }
    jokeApActive = true;
    activeJokeSsid = JOKE_SSIDS[index];
    jokeApStartedMs = millis();
    instance.vibrator();
    markActivity();
    updateCurrentView(true);
}

static void pollJokeAccessPoint()
{
    if (!jokeApActive) {
        return;
    }
    if (sleepRequested ||
        millis() - jokeApStartedMs >= JOKE_AP_DURATION_MS) {
        stopJokeAccessPoint();
    }
}

static void pollCustomHomeButton()
{
    const bool down = digitalRead(CUSTOM_HOME_BUTTON_PIN) == LOW;
    const uint32_t now = millis();
    if (down && !customButtonWasDown &&
        now - customButtonLastActionMs >= CUSTOM_BUTTON_DEBOUNCE_MS) {
        customButtonLastActionMs = now;
        stopAlert();
        clearNavigationHistory();
        currentView = View::WATCH;
        rotateWatchFaceShop(true);
        buildCurrentView();
    }
    customButtonWasDown = down;
}

