            lv_obj_set_width(line, 210);
            lv_obj_set_height(line, 40);
            lv_label_set_long_mode(line, LV_LABEL_LONG_DOT);
            lv_obj_set_style_text_color(
                line, lv_color_hex(THEME_TEXT), 0);
            lv_obj_set_style_text_align(line, LV_TEXT_ALIGN_LEFT, 0);
            lv_label_set_recolor(line, true);
            lv_obj_add_flag(line, LV_OBJ_FLAG_CLICKABLE);
            lv_obj_clear_flag(line, LV_OBJ_FLAG_GESTURE_BUBBLE);
