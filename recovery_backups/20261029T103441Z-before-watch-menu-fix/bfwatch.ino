        lv_obj_set_size(empty, 210, 22);
        lv_label_set_long_mode(empty, LV_LABEL_LONG_DOT);
        lv_obj_set_style_text_align(empty, LV_TEXT_ALIGN_CENTER, 0);
        lv_obj_set_style_text_color(
            empty, lv_color_hex(THEME_MUTED), 0);
        lv_label_set_text(empty, "No active menu snapshot");
    } else {
        for (uint16_t i = 0; i < strainCount; ++i) {
