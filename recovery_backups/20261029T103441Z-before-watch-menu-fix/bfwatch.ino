static void updateWatchView()
{
    if (rotateWatchFaceShop(false)) {
        const uint32_t previousActivityMs = lastActivityMs;
        buildCurrentView();
        lastActivityMs = previousActivityMs;
        return;
    }

    struct tm now = {};
    char timeBuffer[16] = "--:--";
    char dateBuffer[48] = "RTC not set";
    instance.rtc.getDateTime(&now);
    if (now.tm_year + 1900 >= 2020) {
        strftime(timeBuffer, sizeof(timeBuffer), "%H:%M", &now);
        strftime(dateBuffer, sizeof(dateBuffer), "%a %d %b", &now);
    }

    setLabel(primaryLabel, timeBuffer);
    setLabel(secondaryLabel, dateBuffer);

    const char *shopName = "No coffeeshop data";
    char distanceBuffer[24] = "";
    const int16_t displayIndex = watchFaceShopIndex();
    if (displayIndex >= 0 &&
        displayIndex < static_cast<int16_t>(BFWATCH_SHOP_COUNT)) {
        shopName =
            bfwatchString(BFWATCH_SHOPS[displayIndex].nameOffset);
        if (haveFix) {
            formatDistance(
                distanceToShop(displayIndex),
                distanceBuffer, sizeof(distanceBuffer));
        } else {
            snprintf(distanceBuffer, sizeof(distanceBuffer), "GPS --");
        }
    }
    setLabel(tertiaryLabel, shopName);
    setLabel(shopDistanceLabel, distanceBuffer);

    int battery = instance.pmu.getBatteryPercent();
    if (battery < 0 || battery > 100) {
        setLabel(batteryLabel, "--%");
    } else {
        char batteryBuffer[16];
        snprintf(batteryBuffer, sizeof(batteryBuffer), "%d%%%s", battery,
                 instance.pmu.isVbusIn() ? "+" : "");
        setLabel(batteryLabel, batteryBuffer);
    }
}

static uint64_t stopwatchElapsedUs()
{
    if (!stopwatchRunning) {
        return stopwatchAccumulatedUs;
    }
    return stopwatchAccumulatedUs +
           static_cast<uint64_t>(monotonicUs() - stopwatchStartedUs);
}

static void updateStopwatchView()
{
    char buffer[32];
    formatDuration(stopwatchElapsedUs() / 1000ULL, true,
                   buffer, sizeof(buffer));
    setLabel(primaryLabel, buffer);
    if (stopwatchLapCount > 0) {
        char lap[64];
        char lapTime[32];
        formatDuration(
            stopwatchLapsUs[stopwatchLapCount - 1] / 1000ULL,
            true, lapTime, sizeof(lapTime));
        snprintf(lap, sizeof(lap), "Lap %u  %s",
                 stopwatchLapCount, lapTime);
        setLabel(secondaryLabel, lap);
    } else {
        setLabel(secondaryLabel, stopwatchRunning ?
                 "Running - screen may sleep" : "Paused");
    }
}

static void updateSpeedometerView()
{
    const double displaySpeed =
        speedUnit == SpeedUnit::MPH
            ? speedCurrentKph * 0.621371
            : speedCurrentKph;
    const double displayMaximum =
        speedUnit == SpeedUnit::MPH
            ? speedMaximumKph * 0.621371
            : speedMaximumKph;
    const double hours =
        static_cast<double>(speedometerElapsedUs()) /
        3600000000.0;
    const double averageKph =
        hours > 0.0 ? speedDistanceM / 1000.0 / hours : 0.0;
    const double displayAverage =
        speedUnit == SpeedUnit::MPH
            ? averageKph * 0.621371
            : averageKph;
    const double displayDistance =
        speedUnit == SpeedUnit::MPH
            ? speedDistanceM / 1609.344
            : speedDistanceM / 1000.0;
    char speed[24];
    snprintf(speed, sizeof(speed), "%.1f", displaySpeed);
    setLabel(primaryLabel, speed);
    char trip[96];
    snprintf(trip, sizeof(trip),
             "%s  MAX %.1f  AVG %.1f\nTRIP %.2f %s",
             speedUnitName(), displayMaximum, displayAverage,
             displayDistance,
             speedUnit == SpeedUnit::MPH ? "mi" : "km");
    setLabel(secondaryLabel, trip);
    char gps[64];
    const uint32_t satellites = instance.gps.satellites.isValid()
        ? instance.gps.satellites.value() : 0;
    const bool freshLocation =
        instance.gps.location.isValid() &&
        instance.gps.location.age() <= GPS_MAX_FIX_AGE_MS;
    snprintf(gps, sizeof(gps), "%s  //  SAT %u",
             !speedometerRunning
                 ? "STOPPED"
                 : (freshLocation ? "LIVE GPS" : "ACQUIRING"),
             satellites);
    setLabel(statusLabel, gps);
}

static uint64_t timerCurrentRemainingUs()
{
    if (!timerRunning) {
        return timerRemainingUs;
    }
    const int64_t remaining = timerEndsUs - monotonicUs();
    return remaining > 0 ? static_cast<uint64_t>(remaining) : 0ULL;
}

static void updateTimerView()
{
    char buffer[32];
    formatDuration(timerCurrentRemainingUs() / 1000ULL, false,
                   buffer, sizeof(buffer));
    setLabel(primaryLabel, buffer);
    if (timerAlarmVisible) {
        setLabel(secondaryLabel, "TIME UP");
    } else {
        setLabel(secondaryLabel, timerRunning ?
                 "Running - wakes for alarm" : "Paused");
    }
}

static void updateAlarmView()
{
    char time[16];
    snprintf(time, sizeof(time), "%02u:%02u",
             clockAlarmHour, clockAlarmMinute);
    setLabel(primaryLabel, time);
    if (alertRinging && alertSource == AlertSource::CLOCK) {
        setLabel(secondaryLabel, "ALARM RINGING");
        char status[48];
        snprintf(status, sizeof(status), "%s  //  %u%%",
                 alertModeName(),
                 static_cast<unsigned>(alertVolumePercent));
        setLabel(statusLabel, status);
        return;
    }
    if (alarmSnoozeEndsUs > monotonicUs()) {
        const uint32_t seconds = static_cast<uint32_t>(
            (alarmSnoozeEndsUs - monotonicUs()) / 1000000LL);
        char snooze[48];
        snprintf(snooze, sizeof(snooze), "SNOOZED  %u:%02u",
                 seconds / 60U, seconds % 60U);
        setLabel(secondaryLabel, snooze);
    } else {
        setLabel(secondaryLabel, alarmRepeatName());
    }
    const char *field = alarmField == AlarmField::HOUR
        ? "Editing hour"
        : (alarmField == AlarmField::MINUTE
            ? "Editing minute" : "Editing repeat");
    char status[80];
    snprintf(status, sizeof(status), "%s  //  %s",
             clockAlarmEnabled ? "ON" : "OFF", field);
    setLabel(statusLabel, status);
}

