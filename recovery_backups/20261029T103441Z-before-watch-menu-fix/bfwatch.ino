static void buildCurrentView()
{
    if (lastBuiltView == View::TORCH && currentView != View::TORCH) {
        instance.setBrightness(screenBrightness);
    }
    if (speedometerRunning && currentView != View::SPEEDOMETER) {
        stopSpeedometer();
    }
    if (gpsAcquiring && gpsManualRequest && currentView != View::GPS) {
        mapFocusRequested = false;
        stopGpsFix("GNSS cancelled");
    }
    lastBuiltView = currentView;

    switch (currentView) {
    case View::WATCH:     buildWatchView(); break;
    case View::MENU:      buildMenuView(); break;
    case View::NEARBY:    buildNearbyView(); break;
    case View::SHOP:      buildShopView(); break;
    case View::STRAINS:   buildStrainsView(); break;
    case View::STRAIN_SHOPS: buildStrainShopsView(); break;
    case View::SPEEDOMETER: buildSpeedometerView(); break;
    case View::STOPWATCH: buildStopwatchView(); break;
    case View::TIMER:     buildTimerView(); break;
    case View::ALARM:     buildAlarmView(); break;
    case View::INTERVAL:  buildIntervalView(); break;
    case View::STEPS:     buildStepsView(); break;
    case View::BATTERY:   buildBatteryView(); break;
    case View::TORCH:     buildTorchView(); break;
    case View::GPS:       buildGpsView(); break;
    case View::MAP:       buildMapView(); break;
    case View::CLOCK:     buildClockView(); break;
    case View::IR:        buildIrView(); break;
    case View::SETTINGS:  buildSettingsView(); break;
    case View::WIFI_AP:   buildWifiApView(); break;
    }

    finishActiveListLayout();
    updateCurrentView(true);
    markActivity();
}

