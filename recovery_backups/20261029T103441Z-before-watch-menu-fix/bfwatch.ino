static void sendTvPower()
{
    switch (tvProfile) {
    case TvProfile::LG:
        // Common LG 32-bit power toggle. Exact models can require another code.
        IrSender.sendNECMSB(0x20DF10EFUL, 32, false);
        break;
    case TvProfile::SAMSUNG:
        // Common Samsung 32-bit power toggle.
        IrSender.sendSamsungMSB(0xE0E040BFUL, 32);
        break;
    case TvProfile::SONY:
        // Common Sony TV power toggle; Sony expects the command three times.
        for (uint8_t repeat = 0; repeat < 3; ++repeat) {
            IrSender.sendSonyMSB(0xA90UL, 12);
            delay(45);
        }
        break;
    case TvProfile::COUNT:
        return;
    }
    instance.vibrator();
    setLabel(statusLabel, "Signal sent");
    markActivity();
}

static bool powerUpGpsReceiver(bool forceProbe)
{
    instance.powerControl(POWER_GPS, false);
    delay(80);
    instance.powerControl(POWER_GPS, true);
    if (gpsSerialBaud != 0 && gpsSerialBaud != 38400) {
        Serial1.updateBaudRate(gpsSerialBaud);
    }
    delay(GPS_POWER_SETTLE_MS);

    const bool wasDetected =
        (instance.getDeviceProbe() & HW_GPS_ONLINE) != 0;
    if ((forceProbe || !wasDetected) && !instance.initGPS()) {
        Serial.println("BFWatch GNSS: receiver probe failed");
        if (!wasDetected) {
            instance.powerControl(POWER_GPS, false);
            return false;
        }
    } else if (forceProbe || !wasDetected) {
        const uint32_t detectedBaud = Serial1.baudRate();
        if (detectedBaud != 0) {
            gpsSerialBaud = detectedBaud;
        }
    }

    instance.gps.loop(false);
    gpsLastCharsProcessed = instance.gps.charsProcessed();
    gpsCharsAtStart = gpsLastCharsProcessed;
    gpsLastDataMs = millis();
    gpsLastDiagnosticMs = gpsLastDataMs;
    Serial.printf(
        "BFWatch GNSS: powered model=%s baud=%lu chars=%lu probe=%u\n",
        instance.gps.getModel().c_str(),
        static_cast<unsigned long>(gpsSerialBaud),
        static_cast<unsigned long>(gpsLastCharsProcessed),
        (instance.getDeviceProbe() & HW_GPS_ONLINE) != 0 ? 1U : 0U);
    return true;
}

static void restartStalledGpsReceiver()
{
    ++gpsDataRestartCount;
    const bool forceProbe =
        gpsDataRestartCount >= GPS_MAX_DATA_RESTARTS;
    Serial.printf(
        "BFWatch GNSS: no serial data, restart %u/%u%s\n",
        static_cast<unsigned>(gpsDataRestartCount),
        static_cast<unsigned>(GPS_MAX_DATA_RESTARTS),
        forceProbe ? " with probe" : "");
    powerUpGpsReceiver(forceProbe);
    snprintf(
        gpsStatus, sizeof(gpsStatus),
        "GNSS restart %u/%u - waiting for data",
        static_cast<unsigned>(gpsDataRestartCount),
        static_cast<unsigned>(GPS_MAX_DATA_RESTARTS));
    updateCurrentView(true);
}

static void startGpsFix(bool manualRequest)
{
    if (gpsAcquiring) {
        if (manualRequest) {
            gpsManualRequest = true;
            snprintf(gpsStatus, sizeof(gpsStatus),
                     "GNSS is already updating");
            updateCurrentView(true);
        }
        return;
    }
    if (!powerUpGpsReceiver(false)) {
        snprintf(gpsStatus, sizeof(gpsStatus), "GNSS hardware not detected");
        nextGpsUpdateUs = monotonicUs() + 60LL * 1000000LL;
        updateCurrentView(true);
        return;
    }

    gpsStartedMs = millis();
    gpsDataRestartCount = 0;
    gpsLastDiagnosticMs = gpsStartedMs;
    gpsAcquiring = true;
    gpsManualRequest = manualRequest;
    if (manualRequest) {
        snprintf(gpsStatus, sizeof(gpsStatus),
                 "Move outdoors with a clear view of the sky");
        markActivity();
        updateCurrentView(true);
    } else {
        snprintf(
            gpsStatus, sizeof(gpsStatus),
            speedometerRunning
                ? "Speedometer acquiring GNSS"
                : "Automatic GNSS update");
    }
}

static void stopGpsFix(const char *message)
{
    instance.powerControl(POWER_GPS, false);
    gpsAcquiring = false;
    gpsManualRequest = false;
    gpsLastDataMs = 0;
    gpsLastDiagnosticMs = 0;
    gpsDataRestartCount = 0;
    snprintf(gpsStatus, sizeof(gpsStatus), "%s", message);
    updateCurrentView(true);
}

static void refreshLocationDisplay()
{
    if (currentView == View::MAP) {
        if (mapFollowPosition &&
            insideAmsterdam(lastLatitude, lastLongitude)) {
            if (BFWATCH_MAP_HAS_DETAIL_BOUNDS &&
                mapZoom == BFWATCH_MAP_DETAIL_ZOOM &&
                !insideMapDetail(lastLatitude, lastLongitude) &&
                mapZoom > BFWATCH_MAP_MIN_ZOOM) {
                --mapZoom;
            }
            mapCenterLatitude = lastLatitude;
            mapCenterLongitude = lastLongitude;
            clampMapCenter();
        }
        const uint32_t savedActivityMs = lastActivityMs;
        buildCurrentView();
        lastActivityMs = savedActivityMs;
    } else {
        updateCurrentView(true);
    }
}

static void pollGps()
{
    if (!gpsAcquiring) {
        return;
    }

    const uint32_t processed = instance.gps.loop(false);
    const uint32_t nowMs = millis();
    if (processed != gpsLastCharsProcessed) {
        gpsLastCharsProcessed = processed;
        gpsLastDataMs = nowMs;
    } else if (gpsLastDataMs != 0 &&
               nowMs - gpsLastDataMs >= GPS_DATA_STALL_MS &&
               gpsDataRestartCount < GPS_MAX_DATA_RESTARTS) {
        restartStalledGpsReceiver();
        return;
    }

    if (nowMs - gpsLastDiagnosticMs >= GPS_DIAGNOSTIC_INTERVAL_MS) {
        gpsLastDiagnosticMs = nowMs;
        const uint32_t satellites =
            instance.gps.satellites.isValid()
                ? instance.gps.satellites.value()
                : 0U;
        const uint32_t hdop =
            instance.gps.hdop.isValid()
                ? instance.gps.hdop.value()
                : 0U;
        Serial.printf(
            "BFWatch GNSS: t=%lus chars=%lu nmea=%lu bad=%lu "
            "fixSent=%lu sat=%lu hdop=%lu loc=%u age=%lu\n",
            static_cast<unsigned long>(
                (nowMs - gpsStartedMs) / 1000U),
            static_cast<unsigned long>(
                instance.gps.charsProcessed() - gpsCharsAtStart),
            static_cast<unsigned long>(
                instance.gps.passedChecksum()),
            static_cast<unsigned long>(
                instance.gps.failedChecksum()),
            static_cast<unsigned long>(
                instance.gps.sentencesWithFix()),
            static_cast<unsigned long>(satellites),
            static_cast<unsigned long>(hdop),
            instance.gps.location.isValid() ? 1U : 0U,
            static_cast<unsigned long>(
                instance.gps.location.isValid()
                    ? instance.gps.location.age()
                    : 0U));
    }

    const bool freshSentence =
        instance.gps.charsProcessed() > gpsCharsAtStart + 20U;
    const bool freshLocation =
        instance.gps.location.isValid() &&
        instance.gps.location.age() <= GPS_MAX_FIX_AGE_MS;
    const bool updateDue =
        lastGpsAcceptedMs == 0 ||
        nowMs - lastGpsAcceptedMs >=
            (speedometerRunning ? SPEED_REFRESH_MS : GPS_LIVE_REFRESH_MS);

    if (freshSentence && freshLocation && updateDue) {
        const bool wasManualRequest = gpsManualRequest;
        lastLatitude = instance.gps.location.lat();
        lastLongitude = instance.gps.location.lng();
        lastFixEpoch = readRtcEpoch();
        haveFix = true;
        lastGpsAcceptedMs = nowMs;
        Serial.printf(
            "BFWatch GNSS: fix %.6f,%.6f sat=%u age=%lu\n",
            lastLatitude, lastLongitude,
            instance.gps.satellites.isValid()
                ? static_cast<unsigned>(
                      instance.gps.satellites.value())
                : 0U,
            static_cast<unsigned long>(
                instance.gps.location.age()));
        calculateNearest();
        if (speedometerRunning) {
            recordSpeedSample(nowMs);
            if (lastFixSavedMs == 0 ||
                nowMs - lastFixSavedMs >= GPS_FIX_SAVE_INTERVAL_MS) {
                saveFix();
                lastFixSavedMs = nowMs;
            }
            gpsStartedMs = nowMs;
            snprintf(gpsStatus, sizeof(gpsStatus), "Speed tracking");
            refreshLocationDisplay();
            return;
        }
        if (wasManualRequest ||
            !gpsModeTracksLive() ||
            lastFixSavedMs == 0 ||
            nowMs - lastFixSavedMs >= GPS_FIX_SAVE_INTERVAL_MS) {
            saveFix();
            lastFixSavedMs = nowMs;
        }
        if (wasManualRequest) {
            instance.vibrator();
        }

        const bool inAmsterdam =
            insideAmsterdam(lastLatitude, lastLongitude);
        if (mapFocusRequested) {
            mapFocusRequested = false;
            if (inAmsterdam) {
                nextGpsUpdateUs =
                    monotonicUs() + gpsUpdateIntervalUs();
                stopGpsFix("Location updated");
                focusMapOnCurrentLocation();
                currentView = View::MAP;
                buildCurrentView();
                return;
            }
        }
        if (!wasManualRequest && gpsModeTracksLive() && inAmsterdam) {
            gpsStartedMs = nowMs;
            snprintf(
                gpsStatus, sizeof(gpsStatus), "%s",
                gpsUpdateMode == GpsUpdateMode::AMSTERDAM
                    ? "Amsterdam live tracking"
                    : "Live tracking");
            refreshLocationDisplay();
            return;
        }

        nextGpsUpdateUs = monotonicUs() + gpsUpdateIntervalUs();
        stopGpsFix(inAmsterdam
            ? "Location updated"
            : "Fix saved - outside Amsterdam map");
        refreshLocationDisplay();
        return;
    }

    const uint32_t timeoutMs =
        gpsManualRequest ? GPS_MANUAL_TIMEOUT_MS : GPS_AUTO_TIMEOUT_MS;
    if (nowMs - gpsStartedMs >= timeoutMs) {
        if (speedometerRunning) {
            gpsStartedMs = nowMs;
            gpsDataRestartCount = 0;
            restartStalledGpsReceiver();
            return;
        }
        mapFocusRequested = false;
        nextGpsUpdateUs = monotonicUs() + gpsUpdateIntervalUs();
        stopGpsFix(
            instance.gps.charsProcessed() > gpsCharsAtStart + 20U
                ? "Receiver OK - no satellite fix"
                : "No GNSS data - using saved location");
    }
}

static void pollGpsSchedule()
{
    if (gpsAcquiring) {
        return;
    }
    if (!automaticGpsAllowed()) {
        nextGpsUpdateUs = 0;
        return;
    }
    const int64_t nowUs = monotonicUs();
    if (nextGpsUpdateUs == 0 || nowUs >= nextGpsUpdateUs) {
        startGpsFix(false);
    }
}

static void handleTimerExpiry()
{
    if (!timerRunning || timerCurrentRemainingUs() > 0) {
        return;
    }

    timerRunning = false;
    timerRemainingUs = 0;
    timerAlarmVisible = true;
    startAlert(AlertSource::COUNTDOWN);
    markActivity();
    currentView = View::TIMER;
    buildCurrentView();
}

static void buttonEvent(lv_event_t *event)
{
    markActivity();
    const intptr_t action = reinterpret_cast<intptr_t>(lv_event_get_user_data(event));

    if (action == ACTION_MAP_BACK) {
        navigateBack(View::MENU);
        return;
    }

    if (action == ACTION_OPEN_APPS) {
        clearNavigationHistory();
        currentView = View::MENU;
        buildCurrentView();
        return;
    }

    if (action == 17099) {
        menusGroupOpen = false;
        menusScrollOffset = 0;
        buildCurrentView();
        return;
    }
    if (action == 17000 || action == 17001) {
        menusActiveGroup = action == 17000 ? -1 : -2;
        menusGroupOpen = true;
        menusScrollOffset = 0;
        buildCurrentView();
        return;
    }
    if (action >= 17100 &&
        action < 17100 + ALPHABET_BUCKET_COUNT) {
        menusActiveGroup =
            static_cast<int8_t>(action - 17100);
        menusGroupOpen = true;
        menusScrollOffset = 0;
        buildCurrentView();
        return;
    }

    if (action >= 20000 && action < 20256 &&
        detailShopIndex >= 0) {
        MenuStrainView strain = {};
        if (shopMenuStrain(
                static_cast<size_t>(detailShopIndex),
                static_cast<uint16_t>(action - 20000), strain)) {
            // Preserve the shop detail screen as its own navigation step.
            // This makes Map -> Shop -> Strain unwind through Shop first,
            // while also restoring the shop menu's previous scroll position.
            rememberCurrentView();
            snprintf(selectedStrainName, sizeof(selectedStrainName), "%s",
                     strain.name);
            strainActiveLetter =
                alphabetBucket(selectedStrainName);
            strainLetterOpen = true;
            strainFavouritesOpen = false;
            strainShopsScrollOffset = 0;
            saveSettings();
            rebuildStrainShopOrder();
            currentView = View::STRAIN_SHOPS;
            buildCurrentView();
        }
        return;
    }

    if (action == 15999) {
        strainLetterOpen = true;
        strainFavouritesOpen = true;
        strainsScrollOffset = 0;
        buildCurrentView();
        return;
    }

    if (action >= 16000 &&
        action < 16000 + ALPHABET_BUCKET_COUNT) {
        strainActiveLetter =
            static_cast<uint8_t>(action - 16000);
        strainLetterOpen = true;
        strainFavouritesOpen = false;
        strainsScrollOffset = 0;
        buildCurrentView();
        return;
    }

    if (action >= 10000 &&
        action < 10000 + static_cast<intptr_t>(strainCatalogCount)) {
        const uint32_t catalogIndex =
            static_cast<uint32_t>(action - 10000);
        snprintf(selectedStrainName, sizeof(selectedStrainName), "%s",
                 strainCatalogNames[catalogIndex]);
        strainActiveLetter =
            alphabetBucket(selectedStrainName);
        strainLetterOpen = true;
        strainShopsScrollOffset = 0;
        saveSettings();
        rebuildStrainShopOrder();
        rememberCurrentView();
        currentView = View::STRAIN_SHOPS;
        buildCurrentView();
        return;
    }

    if (action >= 6000 &&
        action < 6000 + static_cast<intptr_t>(BFWATCH_SHOP_COUNT)) {
        detailShopIndex = static_cast<int16_t>(action - 6000);
        shopStrainScrollOffset = 0;
        rememberCurrentView();
        currentView = View::SHOP;
        buildCurrentView();
        return;
    }

    if (action >= static_cast<intptr_t>(View::WATCH) &&
        action <= static_cast<intptr_t>(View::WIFI_AP)) {
        const View requestedView = static_cast<View>(action);
        clearNavigationHistory();
        if (requestedView == View::MAP) {
            openOverviewMap();
            return;
        }
        if (requestedView == View::STRAINS) {
            strainLetterOpen = false;
            strainFavouritesOpen = false;
            strainsScrollOffset = 0;
        }
        if (requestedView == View::NEARBY) {
            menusGroupOpen = false;
            menusScrollOffset = 0;
        }
        currentView = requestedView;
        if (currentView == View::CLOCK) {
            clockEditorLoaded = false;
        }
        buildCurrentView();
        return;
    }

    switch (action) {
    case 100: toggleStopwatch(); break;
    case 101: resetStopwatch(); break;
    case 102: addStopwatchLap(); break;
    case 200: addTimerSeconds(30); break;
    case 201: addTimerSeconds(60); break;
    case 202: toggleTimer(); break;
    case 203: resetTimer(); break;
    case 204: addTimerSeconds(10U * 60U); break;
    case 205: addTimerSeconds(60U * 60U); break;
    case 300:
        currentView = View::GPS;
        buildCurrentView();
        startGpsFix();
        return;
    case 301:
        mapFocusRequested = false;
        nextGpsUpdateUs = monotonicUs() + gpsUpdateIntervalUs();
        stopGpsFix("GNSS cancelled");
        break;
    case 400: adjustClockField(-1); break;
    case 401: selectNextClockField(); break;
    case 402: adjustClockField(1); break;
    case 403: saveClock(); return;
    case 500: changeTvProfile(-1); break;
    case 501: changeTvProfile(1); break;
    case 700:
        if (detailShopIndex >= 0) {
            toggleShopFavourite(detailShopIndex);
            buildCurrentView();
            return;
        }
        break;
    case 701:
        if (detailShopIndex >= 0) {
            const View returnView =
                previousNavigationView(View::NEARBY);
            if (returnView != View::STRAIN_SHOPS &&
                !(returnView == View::MAP &&
                  mapStrainFilterActive)) {
                mapStrainFilterActive = false;
                mapFilteredStockistCount = 0;
            }
            rememberCurrentView();
            openShopOnMap(detailShopIndex);
            return;
        }
        break;
    case 702:
        navigateBack(View::NEARBY);
        return;
    case 800:
        if (mapStrainFilterActive) {
            openSelectedStrainMap();
        } else {
            openOverviewMap();
        }
        return;
    case 801:
        if (mapZoom > BFWATCH_MAP_MIN_ZOOM) {
            --mapZoom;
            buildCurrentView();
        }
        return;
    case 703:
        mapStrainFilterActive = false;
        mapFilteredStockistCount = 0;
        rememberCurrentView();
        openShopOnMap(watchFaceShopIndex());
        return;
    case 802:
        if (mapZoom < BFWATCH_MAP_MAX_ZOOM) {
            const uint8_t nextZoom = mapZoom + 1;
            if (BFWATCH_MAP_HAS_DETAIL_BOUNDS &&
                nextZoom == BFWATCH_MAP_DETAIL_ZOOM &&
                !insideMapDetail(
                    mapCenterLatitude, mapCenterLongitude)) {
                instance.vibrator();
                setLabel(mapStatusLabel, "Z16 AVAILABLE IN CENTRE");
                return;
            }
            ++mapZoom;
            clampMapCenter();
            buildCurrentView();
        }
        return;
    case 803:
        if (haveFix &&
            insideAmsterdam(lastLatitude, lastLongitude)) {
            focusMapOnCurrentLocation();
            buildCurrentView();
            return;
        }
        // A saved home position is expected when arriving in Amsterdam.
        // Acquire a fresh fix, then return directly to a following map.
        mapFocusRequested = true;
        currentView = View::GPS;
        buildCurrentView();
        startGpsFix();
        return;
    case 900: changeGpsUpdateMode(-1); buildCurrentView(); return;
    case 901: changeGpsUpdateMode(1); buildCurrentView(); return;
    case 902: changeScreenTimeout(-1); buildCurrentView(); return;
    case 903: changeScreenTimeout(1); buildCurrentView(); return;
    case 904: changeScreenBrightness(-25); buildCurrentView(); return;
    case 905: changeScreenBrightness(25); buildCurrentView(); return;
    case 906: toggleRaiseToWake(); buildCurrentView(); return;
    case 907: changeAlertMode(-1); buildCurrentView(); return;
    case 908: changeAlertMode(1); buildCurrentView(); return;
    case 909: changeSpeedUnit(-1); buildCurrentView(); return;
    case 910: changeSpeedUnit(1); buildCurrentView(); return;
    case 911:
        if (alertAudioPlaying && !alertRinging) {
            stopAlertAudio();
        } else {
            playAlertPulse();
        }
        return;
    case 912: changeAlertVolume(-1); buildCurrentView(); return;
    case 913: changeAlertVolume(1); buildCurrentView(); return;
    case 914: changeWatchShopMode(-1); buildCurrentView(); return;
    case 915: changeWatchShopMode(1); buildCurrentView(); return;
    case 1000: startJokeAccessPoint(0); return;
    case 1001: startJokeAccessPoint(1); return;
    case 1002: stopJokeAccessPoint(); return;
    case 1100:
        if (speedometerRunning) {
            stopSpeedometer();
        } else {
            startSpeedometer();
        }
        buildCurrentView();
        return;
    case 1101: resetSpeedometer(); buildCurrentView(); return;
    case 1200: adjustAlarmField(-1); buildCurrentView(); return;
    case 1201: selectNextAlarmField(); buildCurrentView(); return;
    case 1202: adjustAlarmField(1); buildCurrentView(); return;
    case 1203: toggleClockAlarm(); buildCurrentView(); return;
    case 1204: stopAlert(); buildCurrentView(); return;
    case 1205: snoozeClockAlarm(); return;
    case 1300: adjustIntervalMinutes(true, -1); buildCurrentView(); return;
    case 1301: adjustIntervalMinutes(true, 1); buildCurrentView(); return;
    case 1302: adjustIntervalMinutes(false, -1); buildCurrentView(); return;
    case 1303: toggleInterval(); buildCurrentView(); return;
    case 1304: resetInterval(); buildCurrentView(); return;
    case 1305: adjustIntervalMinutes(false, 1); buildCurrentView(); return;
    case 1400:
        if (motionSensorReady) {
            instance.sensor.resetPedometer();
            instance.vibrator();
        }
        updateCurrentView(true);
        return;
    case 1502:
        rememberCurrentView();
        openSelectedStrainMap();
        return;
    case 1503:
        navigateBack(View::STRAINS);
        return;
    case 1504:
        toggleSelectedStrainFavourite();
        buildCurrentView();
        return;
    case 1506:
        strainLetterOpen = false;
        strainFavouritesOpen = false;
        strainsScrollOffset = 0;
        buildCurrentView();
        return;
    default: break;
    }

    instance.vibrator();
    updateCurrentView(true);
}

static void mapDragEvent(lv_event_t *event)
{
    lv_indev_t *indev = lv_indev_active();
    if (indev == nullptr) {
        return;
    }

    const lv_event_code_t code = lv_event_get_code(event);
    lv_point_t point = {};
    lv_indev_get_point(indev, &point);

    if (code == LV_EVENT_PRESSED) {
        mapDragStartPoint = point;
        mapDragStartWorldX =
            longitudeToWorldX(mapCenterLongitude, mapZoom);
        mapDragStartWorldY =
            latitudeToWorldY(mapCenterLatitude, mapZoom);
        mapDragging = true;
        markActivity();
        return;
    }

    if (!mapDragging) {
        return;
    }

    const int16_t deltaX = point.x - mapDragStartPoint.x;
    const int16_t deltaY = point.y - mapDragStartPoint.y;
    if (code == LV_EVENT_PRESSING) {
        for (size_t index = 0; index < mapMovableCount; ++index) {
            if (mapMovables[index].object != nullptr) {
                lv_obj_set_pos(mapMovables[index].object,
                               mapMovables[index].x + deltaX,
                               mapMovables[index].y + deltaY);
            }
        }
        markActivity();
    } else if (code == LV_EVENT_RELEASED ||
               code == LV_EVENT_PRESS_LOST) {
        mapDragging = false;
        if (abs(deltaX) < 4 && abs(deltaY) < 4) {
            if (mapZoom >= 13 || mapStrainFilterActive) {
                int32_t closestDistanceSquared = INT32_MAX;
                int16_t closestShop = -1;
                for (size_t index = 0; index < mapMarkerPointCount; ++index) {
                    const MapMarkerPoint &marker = mapMarkerPoints[index];
                    if (marker.shopIndex == UINT16_MAX) {
                        continue;
                    }
                    const int32_t x = point.x - marker.x;
                    const int32_t y = point.y - marker.y;
                    const int32_t distanceSquared = x * x + y * y;
                    const int32_t hitRadius = max(
                        static_cast<int32_t>(14),
                        static_cast<int32_t>(marker.size) / 2 + 6);
                    if (distanceSquared <= hitRadius * hitRadius &&
                        distanceSquared <= closestDistanceSquared) {
                        closestDistanceSquared = distanceSquared;
                        closestShop = static_cast<int16_t>(marker.shopIndex);
                    }
                }
                if (closestShop >= 0) {
                    rememberCurrentView();
                    mapFocusedShopIndex = closestShop;
                    detailShopIndex = closestShop;
                    shopStrainScrollOffset = 0;
                    currentView = View::SHOP;
                    buildCurrentView();
                }
            }
            return;
        }
        const double requestedLongitude =
            worldXToLongitude(mapDragStartWorldX - deltaX, mapZoom);
        const double requestedLatitude =
            worldYToLatitude(mapDragStartWorldY - deltaY, mapZoom);
        mapCenterLongitude = requestedLongitude;
        mapCenterLatitude = requestedLatitude;
        clampMapCenter();
        Serial.printf(
            "Map pan: z=%u strain=%u delta=%d,%d "
            "requested=%.6f,%.6f final=%.6f,%.6f\n",
            static_cast<unsigned>(mapZoom),
            mapStrainFilterActive ? 1U : 0U,
            static_cast<int>(deltaX),
            static_cast<int>(deltaY),
            requestedLatitude, requestedLongitude,
            mapCenterLatitude, mapCenterLongitude);
        mapFollowPosition = false;
        mapCenterInitialized = true;
        buildCurrentView();
    }
}

static void gestureEvent(lv_event_t *event)
{
    (void)event;
    if (currentView == View::MAP) {
        return;
    }
    lv_indev_t *indev = lv_indev_active();
    if (indev == nullptr) {
        return;
    }

    const lv_dir_t direction = lv_indev_get_gesture_dir(indev);
    if (direction == LV_DIR_LEFT && currentView != View::MENU) {
        lv_indev_wait_release(indev);
        clearNavigationHistory();
        currentView = View::MENU;
        buildCurrentView();
    } else if (direction == LV_DIR_RIGHT && currentView != View::WATCH) {
        lv_indev_wait_release(indev);
        clearNavigationHistory();
        currentView = View::WATCH;
        buildCurrentView();
    }
}

static void irPowerEvent(lv_event_t *event)
{
    (void)event;
    sendTvPower();
}

// -----------------------------------------------------------------------------
// Power management
// -----------------------------------------------------------------------------

static uint32_t currentTimeoutMs()
{
    return SCREEN_TIMEOUT_OPTIONS_MS[screenTimeoutIndex];
}

static void enterLowPowerSleep()
{
    if (speedometerRunning) {
        return;
    }
    const bool liveGpsMaySleep =
        gpsAcquiring && !gpsManualRequest && gpsModeTracksLive();
    if (gpsAcquiring && !liveGpsMaySleep) {
        return;
    }
    bool keepAmsterdamGpsWarm = amsterdamGpsWarmHoldAllowed();
    const int64_t amsterdamWarmHoldEndsUs =
        keepAmsterdamGpsWarm
            ? monotonicUs() +
                static_cast<int64_t>(AMSTERDAM_GPS_WARM_HOLD_MS) * 1000LL
            : 0;
    if (gpsAcquiring && !keepAmsterdamGpsWarm) {
        instance.powerControl(POWER_GPS, false);
        gpsAcquiring = false;
        gpsManualRequest = false;
        gpsLastDataMs = 0;
        gpsDataRestartCount = 0;
        nextGpsUpdateUs = 0;
        snprintf(
            gpsStatus, sizeof(gpsStatus), "%s",
            gpsUpdateMode == GpsUpdateMode::AMSTERDAM
                ? "Amsterdam GPS resting to save battery"
                : "Live tracking paused while screen sleeps");
    }

    // Wake for the earliest software timer. Amsterdam Mode also wakes once
    // after its warm-lock window so it can quietly switch the GNSS rail off.
    const auto armSleepTimer = [&](uint64_t gpsWarmRemainingUs) {
        esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_TIMER);
        uint64_t wakeRemainingUs = gpsWarmRemainingUs;
        const int64_t nowUs = monotonicUs();
        const uint64_t countdownRemaining =
            timerRunning ? timerCurrentRemainingUs() : 0;
        const uint64_t intervalRemaining =
            intervalRunning ? intervalCurrentRemainingUs() : 0;
        const uint64_t snoozeRemaining =
            alarmSnoozeEndsUs > nowUs
                ? static_cast<uint64_t>(alarmSnoozeEndsUs - nowUs)
                : 0;
        for (const uint64_t candidate : {
                 countdownRemaining, intervalRemaining, snoozeRemaining}) {
            if (candidate > 0 &&
                (wakeRemainingUs == 0 || candidate < wakeRemainingUs)) {
                wakeRemainingUs = candidate;
            }
        }
        if (wakeRemainingUs == 0) {
            return false;
        }
        if (wakeRemainingUs < 100000ULL) {
            wakeRemainingUs = 100000ULL;
        }
        esp_sleep_enable_timer_wakeup(wakeRemainingUs);
        return true;
    };
    bool timerWakeEnabled = armSleepTimer(
        keepAmsterdamGpsWarm
            ? static_cast<uint64_t>(AMSTERDAM_GPS_WARM_HOLD_MS) * 1000ULL
            : 0);

    lv_task_handler();
    instance.setBrightness(0);
    delay(25);

    // This is intentionally local rather than instance.lightSleep(). The
    // current LilyGoLib helper wakes the LoRa radio and GNSS on return; BFWatch
    // keeps both rails off unless a feature explicitly needs them.
    instance.powerControl(POWER_DISPLAY_BACKLIGHT, false);
    instance.powerControl(POWER_HAPTIC_DRIVER, false);
    if (!keepAmsterdamGpsWarm) {
        instance.powerControl(POWER_GPS, false);
    }
    instance.powerControl(POWER_RADIO, false);
    instance.powerControl(POWER_SPEAK, false);
    instance.LilyGoDispSPI::sleep();

    instance.pmu.disableIRQ(XPOWERS_AXP2101_ALL_IRQ);
    instance.pmu.clearIrqStatus();
    instance.pmu.enableIRQ(XPOWERS_AXP2101_PKEY_SHORT_IRQ);
    rtc_gpio_pullup_en(static_cast<gpio_num_t>(PMU_INT));
    pinMode(CUSTOM_HOME_BUTTON_PIN, INPUT_PULLUP);
    rtc_gpio_pullup_en(
        static_cast<gpio_num_t>(CUSTOM_HOME_BUTTON_PIN));
    if (clockAlarmEnabled) {
        pinMode(RTC_INT, INPUT_PULLUP);
        rtc_gpio_pullup_en(static_cast<gpio_num_t>(RTC_INT));
    }

    bool sensorWakeArmed =
        raiseToWakeEnabled && motionSensorReady;
    if (sensorWakeArmed) {
        instance.sensor.readIrqStatus();
        delay(1);
        // A stuck-low sensor interrupt would otherwise wake immediately.
        // Excluding it preserves the proven touch/power wake path.
        sensorWakeArmed = digitalRead(SENSOR_INT) != LOW;
    }
    uint64_t wakePins =
        _BV(TP_INT) | _BV(PMU_INT) |
        _BV(CUSTOM_HOME_BUTTON_PIN);
    if (clockAlarmEnabled) {
        wakePins |= _BV(RTC_INT);
    }
    if (sensorWakeArmed) {
        wakePins |= _BV(SENSOR_INT);
    }
#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 0, 0)
    esp_sleep_enable_ext1_wakeup_io(wakePins, ESP_EXT1_WAKEUP_ANY_LOW);
#else
    esp_sleep_enable_ext1_wakeup(wakePins, ESP_EXT1_WAKEUP_ANY_LOW);
#endif

    esp_light_sleep_start();
    esp_sleep_wakeup_cause_t wakeCause = esp_sleep_get_wakeup_cause();
    if (timerWakeEnabled) {
        esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_TIMER);
        timerWakeEnabled = false;
    }

    // If only the warm-lock timer fired, shut GNSS down and remain asleep.
    // A countdown, interval timer or alarm that is actually due still wakes
    // the display normally.
    if (keepAmsterdamGpsWarm &&
        wakeCause == ESP_SLEEP_WAKEUP_TIMER &&
        monotonicUs() >= amsterdamWarmHoldEndsUs) {
        const int64_t nowUs = monotonicUs();
        const bool softwareAlertDue =
            (timerRunning && timerCurrentRemainingUs() == 0) ||
            (intervalRunning && intervalCurrentRemainingUs() == 0) ||
            (alarmSnoozeEndsUs > 0 && alarmSnoozeEndsUs <= nowUs);
        if (!softwareAlertDue) {
            instance.powerControl(POWER_GPS, false);
            gpsAcquiring = false;
            gpsManualRequest = false;
            gpsLastDataMs = 0;
            gpsLastDiagnosticMs = 0;
            gpsDataRestartCount = 0;
            nextGpsUpdateUs = 0;
            keepAmsterdamGpsWarm = false;
            snprintf(gpsStatus, sizeof(gpsStatus),
                     "Amsterdam GPS resting to save battery");

            timerWakeEnabled = armSleepTimer(0);
            esp_light_sleep_start();
            wakeCause = esp_sleep_get_wakeup_cause();
            if (timerWakeEnabled) {
                esp_sleep_disable_wakeup_source(
                    ESP_SLEEP_WAKEUP_TIMER);
                timerWakeEnabled = false;
            }
        }
    }
    const uint64_t ext1WakePins =
        wakeCause == ESP_SLEEP_WAKEUP_EXT1
            ? esp_sleep_get_ext1_wakeup_status()
            : 0;
    const bool wokeByRaise =
        sensorWakeArmed && (ext1WakePins & _BV(SENSOR_INT)) != 0;
    const bool wokeByHome =
        (ext1WakePins & _BV(CUSTOM_HOME_BUTTON_PIN)) != 0;
    const bool wokeByClock =
        clockAlarmEnabled &&
        (ext1WakePins & _BV(RTC_INT)) != 0;
    if (wokeByClock) {
        lastClockAlarmPollMs = millis() - 500U;
    }
    customButtonWasDown =
        digitalRead(CUSTOM_HOME_BUTTON_PIN) == LOW;

    esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_EXT1);
    if (wokeByRaise) {
        instance.sensor.readIrqStatus();
    }

    instance.pmu.disableIRQ(XPOWERS_AXP2101_ALL_IRQ);
    instance.pmu.enableIRQ(
        XPOWERS_AXP2101_PKEY_SHORT_IRQ |
        XPOWERS_AXP2101_PKEY_LONG_IRQ |
        XPOWERS_AXP2101_VBUS_INSERT_IRQ |
        XPOWERS_AXP2101_VBUS_REMOVE_IRQ |
        XPOWERS_AXP2101_BAT_CHG_START_IRQ |
        XPOWERS_AXP2101_BAT_CHG_DONE_IRQ);
    instance.pmu.clearIrqStatus();

    instance.LilyGoDispSPI::wakeup();
    instance.powerControl(POWER_DISPLAY_BACKLIGHT, true);
    instance.powerControl(POWER_HAPTIC_DRIVER, true);
    instance.setBrightness(screenBrightness);

    ignorePowerButtonUntilMs = millis() + 600U;
    sleepRequested = false;
    markActivity();
    handleTimerExpiry();
    handleIntervalExpiry();
    pollClockAlarm();
    if (alertRinging) {
        currentView =
            alertSource == AlertSource::CLOCK
                ? View::ALARM : View::TIMER;
        buildCurrentView();
    } else if (wokeByHome) {
        stopAlert();
        clearNavigationHistory();
        currentView = View::WATCH;
        rotateWatchFaceShop(true);
        buildCurrentView();
    } else if (wokeByRaise) {
        clearNavigationHistory();
        currentView = View::WATCH;
        rotateWatchFaceShop(true);
        buildCurrentView();
    } else if (currentView == View::WATCH) {
        rotateWatchFaceShop(true);
        buildCurrentView();
    } else if (currentView == View::TORCH) {
        buildCurrentView();
    } else {
        updateCurrentView(true);
    }
    pollGpsSchedule();
}

// -----------------------------------------------------------------------------
// Map package upload protocol
// -----------------------------------------------------------------------------

static uint32_t updateCrc32(uint32_t crc, const uint8_t *data, size_t length)
{
    for (size_t index = 0; index < length; ++index) {
        crc ^= data[index];
        for (uint8_t bit = 0; bit < 8; ++bit) {
            crc = (crc >> 1) ^ (0xEDB88320UL & (0UL - (crc & 1UL)));
        }
    }
    return crc;
}

static bool makeMapParentDirectories(char *path)
{
    for (char *cursor = path + 1; *cursor != '\0'; ++cursor) {
        if (*cursor != '/') {
            continue;
        }
        *cursor = '\0';
        if (!FFat.exists(path) && !FFat.mkdir(path)) {
            *cursor = '/';
            return false;
        }
        *cursor = '/';
    }
    return true;
}

static bool isMapUploadPath(const char *relativePath)
{
    if (strcmp(relativePath, "map.idx") == 0 ||
        strcmp(relativePath, "logos.idx") == 0 ||
        strcmp(relativePath, "logos.bin") == 0 ||
        strcmp(relativePath, "menus.bin") == 0) {
        return true;
    }
    return strlen(relativePath) == 9 &&
           strncmp(relativePath, "map", 3) == 0 &&
           relativePath[3] >= '0' && relativePath[3] <= '9' &&
           relativePath[4] >= '0' && relativePath[4] <= '9' &&
           strcmp(relativePath + 5, ".bin") == 0;
}

static void receiveMapFile(const char *relativePath, uint32_t expectedSize,
                           uint32_t expectedCrc)
{
    if (!mapStorageReady || strstr(relativePath, "..") != nullptr ||
        !isMapUploadPath(relativePath)) {
        Serial.println("BFMAP_ERROR invalid_path");
        return;
    }

    char fullPath[112];
    snprintf(fullPath, sizeof(fullPath), "/%s", relativePath);
    if (!makeMapParentDirectories(fullPath)) {
        Serial.println("BFMAP_ERROR mkdir_failed");
        return;
    }

    File output = FFat.open(fullPath, FILE_WRITE);
    if (!output) {
        Serial.println("BFMAP_ERROR open_failed");
        return;
    }

    Serial.printf("BFMAP_GO %u\n",
                  static_cast<unsigned>(MAP_UPLOAD_BLOCK_SIZE));
    Serial.flush();

    uint8_t buffer[MAP_UPLOAD_BLOCK_SIZE];
    uint32_t received = 0;
    uint32_t crc = 0xFFFFFFFFUL;
    uint32_t lastDataMs = millis();
    bool writeFailed = false;

    while (received < expectedSize) {
        const size_t blockTarget = min(
            sizeof(buffer), static_cast<size_t>(expectedSize - received));
        size_t blockReceived = 0;
        while (blockReceived < blockTarget) {
            const int available = Serial.available();
            if (available <= 0) {
                if (millis() - lastDataMs > MAP_UPLOAD_TIMEOUT_MS) {
                    output.close();
                    FFat.remove(fullPath);
                    mapUploadActive = true;
                    mapUploadLastActivityMs = millis();
                    Serial.println("BFMAP_ERROR receive_timeout");
                    return;
                }
                delay(1);
                continue;
            }

            const size_t wanted = min(
                static_cast<size_t>(available), blockTarget - blockReceived);
            const size_t count =
                Serial.readBytes(buffer + blockReceived, wanted);
            if (count == 0) {
                continue;
            }
            lastDataMs = millis();
            blockReceived += count;
        }

        if (output.write(buffer, blockReceived) != blockReceived) {
            writeFailed = true;
            break;
        }
        crc = updateCrc32(crc, buffer, blockReceived);
        received += blockReceived;
        if (received < expectedSize) {
            Serial.printf("BFMAP_MORE %lu\n",
                          static_cast<unsigned long>(received));
            Serial.flush();
        }
    }

    output.flush();
    output.close();
    crc ^= 0xFFFFFFFFUL;

    if (writeFailed || received != expectedSize || crc != expectedCrc) {
        FFat.remove(fullPath);
        Serial.printf("BFMAP_ERROR verify_failed %lu %08lX\n",
                      static_cast<unsigned long>(received),
                      static_cast<unsigned long>(crc));
        return;
    }

    Serial.printf("BFMAP_OK %s %lu %08lX\n", relativePath,
                  static_cast<unsigned long>(received),
                  static_cast<unsigned long>(crc));
    markActivity();
}

static void handleMapUploadCommand(const char *line)
{
    if (strcmp(line, "BFMAP_HELLO") == 0) {
        if (!mapStorageReady) {
            Serial.println("BFMAP_ERROR storage_unavailable");
            return;
        }
        mapUploadActive = true;
        mapUploadLastActivityMs = millis();
        Serial.printf("BFMAP_READY %u %u\n",
                      static_cast<unsigned>(FFat.totalBytes()),
                      static_cast<unsigned>(FFat.freeBytes()));
        markActivity();
        return;
    }

    if (strcmp(line, "BFMAP_BEGIN") == 0) {
        if (!mapStorageReady) {
            Serial.println("BFMAP_ERROR storage_unavailable");
            return;
        }
        mapUploadActive = true;
        mapUploadLastActivityMs = millis();
        unloadLogoIndex();
        logoPackageReady = false;
        unloadMenuPackage();
        Serial.println("BFMAP_BEGIN_OK");
        markActivity();
        return;
    }

    if (strcmp(line, "BFMAP_CLEAR") == 0) {
        if (!mapStorageReady) {
            Serial.println("BFMAP_ERROR storage_unavailable");
            return;
        }
        mapUploadActive = true;
        mapUploadLastActivityMs = millis();
        unloadMapPackIndex();
        unloadLogoIndex();
        unloadMenuPackage();
        mapStorageReady = false;
        FFat.end();
        const bool formatted = FFat.format(FFAT_WIPE_QUICK);
        mapStorageReady = FFat.begin(true, "/sd");
        mapPackageReady = false;
        logoPackageReady = false;
        menuPackageReady = false;
        if (formatted && mapStorageReady) {
            Serial.printf("BFMAP_CLEAR_OK %u\n",
                          static_cast<unsigned>(FFat.freeBytes()));
        } else {
            Serial.println("BFMAP_ERROR clear_failed");
        }
        return;
    }

    if (strncmp(line, "BFMAP_PUT ", 10) == 0) {
        char relativePath[96] = {};
        unsigned long size = 0;
        unsigned long crc = 0;
        if (sscanf(line + 10, "%95s %lu %lx",
                   relativePath, &size, &crc) != 3) {
            Serial.println("BFMAP_ERROR malformed_put");
            return;
        }
        mapUploadActive = true;
        mapUploadLastActivityMs = millis();
        receiveMapFile(relativePath, static_cast<uint32_t>(size),
                       static_cast<uint32_t>(crc));
        return;
    }

    if (strcmp(line, "BFMAP_DONE") == 0) {
        mapUploadActive = false;
        mapPackageReady = mapFilesInstalled();
        logoPackageReady = loadLogoIndex();
        menuPackageReady = loadMenuPackage();
        Serial.printf("BFMAP_DONE_OK %u map=%u logos=%u menus=%u\n",
                      static_cast<unsigned>(FFat.usedBytes()),
                      mapPackageReady ? 1U : 0U,
                      logoPackageReady ? 1U : 0U,
                      menuPackageReady ? 1U : 0U);
        if (currentView == View::MAP || currentView == View::SHOP ||
            currentView == View::STRAINS ||
            currentView == View::STRAIN_SHOPS) {
            buildCurrentView();
        }
        return;
    }

    if (strcmp(line, "BFMAP_ABORT") == 0) {
        mapUploadActive = false;
        Serial.println("BFMAP_ABORTED");
    }
}

static void pollMapUpload()
{
    while (Serial.available() > 0) {
        const int incoming = Serial.read();
        if (incoming < 0) {
            break;
        }
        const char character = static_cast<char>(incoming);
        if (character == '\r') {
            continue;
        }
        if (character == '\n') {
            mapUploadLine[mapUploadLineLength] = '\0';
            if (mapUploadLineLength > 0 &&
                strncmp(mapUploadLine, "BFMAP_", 6) == 0) {
                handleMapUploadCommand(mapUploadLine);
            }
            mapUploadLineLength = 0;
            continue;
        }
        if (mapUploadLineLength + 1 < sizeof(mapUploadLine)) {
            mapUploadLine[mapUploadLineLength++] = character;
        } else {
            mapUploadLineLength = 0;
        }
    }
}

// -----------------------------------------------------------------------------
// Arduino lifecycle
// -----------------------------------------------------------------------------

void setup()
{
    Serial.begin(115200);
    delay(50);
    Serial.printf("BFWatch reset reason: %d\n",
                  static_cast<int>(esp_reset_reason()));

    // Keep only the hardware used by BFWatch. LilyGoLib's automatic FATFS
    // setup mounts at /fs, while this LVGL build reads its A: drive from /sd,
    // so BFWatch mounts the dedicated FFat partition itself below.
    const uint32_t disabledHardware =
        NO_SCAN_I2C_DEV | NO_HW_MIC |
        NO_HW_LORA | NO_INIT_FATFS;

    instance.begin(disabledHardware);
    const uint32_t detectedGpsBaud = Serial1.baudRate();
    if (detectedGpsBaud != 0) {
        gpsSerialBaud = detectedGpsBaud;
    }
    Serial.printf(
        "BFWatch GNSS: boot model=%s baud=%lu probe=%u\n",
        instance.gps.getModel().c_str(),
        static_cast<unsigned long>(gpsSerialBaud),
        (instance.getDeviceProbe() & HW_GPS_ONLINE) != 0 ? 1U : 0U);
    // LilyGoLib uses NO_HW_MIC to skip both microphone and PCM-amplifier
    // setup. BFWatch does not need the microphone, so initialize only the
    // I2S speaker explicitly and leave its power rail off between alerts.
    speakerReady = initializeSpeaker();
    Serial.printf("BFWatch audio: amplifier=%u rate=%u\n",
                  speakerReady ? 1U : 0U,
                  speakerReady
                      ? static_cast<unsigned>(
                            instance.player.txSampleRate())
                      : 0U);
    mapStorageReady = FFat.begin(true, "/sd");
    mapPackageReady = mapFilesInstalled();
    logoPackageReady = loadLogoIndex();
    menuPackageReady = loadMenuPackage();
    if (mapStorageReady) {
        Serial.printf(
            "BFWatch FFat: %u total, %u used, map=%u, logos=%u, menus=%u\n",
                      static_cast<unsigned>(FFat.totalBytes()),
                      static_cast<unsigned>(FFat.usedBytes()),
                      mapPackageReady ? 1U : 0U,
                      logoPackageReady ? 1U : 0U,
                      menuPackageReady ? 1U : 0U);
    } else {
        Serial.println("BFWatch FFat mount failed");
    }
    beginLvglHelper(instance);
    registerMapPackFileSystem();

    WiFi.mode(WIFI_OFF);
    instance.powerControl(POWER_RADIO, false);
    instance.powerControl(POWER_SPEAK, false);
    instance.powerControl(POWER_GPS, false);
    instance.setHapticEffects(47);
    IrSender.begin(IR_SEND);

    loadFix();
    loadShopPreferences();
    loadStrainPreferences();
    loadSettings();
    configureRaiseToWakeSensor();
    configureClockAlarm();
    pinMode(CUSTOM_HOME_BUTTON_PIN, INPUT_PULLUP);
    customButtonWasDown =
        digitalRead(CUSTOM_HOME_BUTTON_PIN) == LOW;
    instance.setBrightness(screenBrightness);

    instance.onEvent([](DeviceEvent_t event, void *params, void *userData) {
        (void)event;
        (void)userData;
        if (instance.getPMUEventType(params) == PMU_EVENT_KEY_CLICKED &&
            millis() >= ignorePowerButtonUntilMs) {
            sleepRequested = true;
        }
    }, POWER_EVENT, nullptr);

    snprintf(gpsStatus, sizeof(gpsStatus),
             haveFix ? "Saved location available" : "GNSS is off");

    buildCurrentView();
    lv_task_handler();
}

void loop()
{
    instance.loop();
    pollCustomHomeButton();
    pollMapUpload();
    if (mapUploadActive &&
        millis() - mapUploadLastActivityMs > MAP_UPLOAD_IDLE_TIMEOUT_MS) {
        mapUploadActive = false;
    }
    pollGps();
    pollGpsSchedule();
    pollJokeAccessPoint();
    handleTimerExpiry();
    handleIntervalExpiry();
    pollClockAlarm();
    serviceAlert();
    updateCurrentView(false);

    lv_task_handler();
    delay(5);

    const bool liveGpsMaySleep =
        gpsAcquiring && !gpsManualRequest &&
        gpsModeTracksLive();
    if (!mapUploadActive && !jokeApActive && !alertRinging &&
        !alertAudioPlaying &&
        !speedometerRunning &&
        (sleepRequested ||
         ((!gpsAcquiring || liveGpsMaySleep) &&
          millis() - lastActivityMs >= currentTimeoutMs()))) {
        enterLowPowerSleep();
    }
}
