static bool viewHasRunningState(View view)
{
    switch (view) {
    case View::STOPWATCH: return stopwatchRunning;
    case View::TIMER: return timerRunning ||
        (alertRinging && alertSource == AlertSource::COUNTDOWN);
    case View::ALARM: return clockAlarmEnabled ||
        (alertRinging && alertSource == AlertSource::CLOCK);
    case View::INTERVAL: return intervalRunning;
    case View::SPEEDOMETER: return speedometerRunning;
    case View::WIFI_AP: return jokeApActive;
    case View::GPS: return gpsAcquiring;
    default: return false;
    }
}

