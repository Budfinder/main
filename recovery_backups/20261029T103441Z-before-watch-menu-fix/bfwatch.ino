static void toggleStopwatch()
{
    if (stopwatchRunning) {
        stopwatchAccumulatedUs +=
            static_cast<uint64_t>(monotonicUs() - stopwatchStartedUs);
        stopwatchRunning = false;
    } else {
        stopwatchStartedUs = monotonicUs();
        stopwatchRunning = true;
    }
}

static void addStopwatchLap()
{
    if (!stopwatchRunning) {
        return;
    }
    const uint64_t elapsed = stopwatchElapsedUs();
    if (stopwatchLapCount < MAX_STOPWATCH_LAPS) {
        stopwatchLapsUs[stopwatchLapCount++] = elapsed;
    } else {
        for (size_t index = 1; index < MAX_STOPWATCH_LAPS; ++index) {
            stopwatchLapsUs[index - 1] = stopwatchLapsUs[index];
        }
        stopwatchLapsUs[MAX_STOPWATCH_LAPS - 1] = elapsed;
    }
    instance.vibrator();
}

static void resetStopwatch()
{
    stopwatchRunning = false;
    stopwatchStartedUs = 0;
    stopwatchAccumulatedUs = 0;
    stopwatchLapCount = 0;
    memset(stopwatchLapsUs, 0, sizeof(stopwatchLapsUs));
}

static void addTimerSeconds(uint32_t seconds)
{
    stopAlert();
    timerAlarmVisible = false;
    const uint64_t addition = static_cast<uint64_t>(seconds) * 1000000ULL;
    if (timerRunning) {
        timerEndsUs += static_cast<int64_t>(addition);
    } else {
        timerRemainingUs += addition;
    }
}

static void toggleTimer()
{
    stopAlert();
    timerAlarmVisible = false;
    if (timerRunning) {
        timerRemainingUs = timerCurrentRemainingUs();
        timerRunning = false;
    } else if (timerRemainingUs > 0) {
        timerEndsUs = monotonicUs() + static_cast<int64_t>(timerRemainingUs);
        timerRunning = true;
    }
}

static void resetTimer()
{
    stopAlert();
    timerRunning = false;
    timerEndsUs = 0;
    timerRemainingUs = DEFAULT_TIMER_US;
    timerAlarmVisible = false;
}

static uint64_t speedometerElapsedUs()
{
    return speedAccumulatedUs +
           (speedometerRunning
                ? static_cast<uint64_t>(monotonicUs() - speedStartedUs)
                : 0ULL);
}

static void startSpeedometer()
{
    if (speedometerRunning) {
        return;
    }
    speedometerRunning = true;
    speedStartedUs = monotonicUs();
    speedLastSampleMs = 0;
    startGpsFix(false);
}

static void stopSpeedometer()
{
    if (speedometerRunning) {
        speedAccumulatedUs +=
            static_cast<uint64_t>(monotonicUs() - speedStartedUs);
    }
    speedometerRunning = false;
    speedStartedUs = 0;
    speedCurrentKph = 0.0;
    speedLastSampleMs = 0;
    if (gpsAcquiring) {
        instance.powerControl(POWER_GPS, false);
        gpsAcquiring = false;
        gpsManualRequest = false;
        gpsLastDataMs = 0;
        gpsDataRestartCount = 0;
        snprintf(gpsStatus, sizeof(gpsStatus), "Speedometer stopped");
    }
}

static void resetSpeedometer()
{
    const bool restart = speedometerRunning;
    stopSpeedometer();
    speedMaximumKph = 0.0;
    speedDistanceM = 0.0;
    speedAccumulatedUs = 0;
    if (restart) {
        startSpeedometer();
    }
}

static void recordSpeedSample(uint32_t nowMs)
{
    double speed = 0.0;
    if (instance.gps.speed.isValid() &&
        instance.gps.speed.age() <= GPS_MAX_FIX_AGE_MS) {
        speed = instance.gps.speed.kmph();
        if (!isfinite(speed) || speed < 0.8 || speed > 350.0) {
            speed = 0.0;
        }
    }
    if (speedLastSampleMs > 0 && nowMs > speedLastSampleMs) {
        const double seconds =
            static_cast<double>(nowMs - speedLastSampleMs) / 1000.0;
        speedDistanceM += speed / 3.6 * seconds;
    }
    speedLastSampleMs = nowMs;
    speedCurrentKph = speed;
    speedMaximumKph = max(speedMaximumKph, speed);
}

static uint64_t intervalCurrentRemainingUs()
{
    if (!intervalRunning) {
        return intervalRemainingUs;
    }
    const int64_t remaining = intervalEndsUs - monotonicUs();
    return remaining > 0 ? static_cast<uint64_t>(remaining) : 0ULL;
}

static void setIntervalForCurrentPhase()
{
    intervalRemainingUs =
        static_cast<uint64_t>(
            intervalWorkPhase
                ? intervalWorkMinutes
                : intervalBreakMinutes) *
        60ULL * 1000000ULL;
}

static void toggleInterval()
{
    if (intervalRunning) {
        intervalRemainingUs = intervalCurrentRemainingUs();
        intervalRunning = false;
    } else if (intervalRemainingUs > 0) {
        intervalEndsUs =
            monotonicUs() + static_cast<int64_t>(intervalRemainingUs);
        intervalRunning = true;
    }
}

static void resetInterval()
{
    intervalRunning = false;
    intervalWorkPhase = true;
    intervalRounds = 0;
    intervalEndsUs = 0;
    setIntervalForCurrentPhase();
}

static void adjustIntervalMinutes(bool work, int8_t amount)
{
    if (intervalRunning) {
        return;
    }
    uint8_t &value = work ? intervalWorkMinutes : intervalBreakMinutes;
    const uint8_t maximum = work ? 90 : 30;
    int16_t next = static_cast<int16_t>(value) + amount;
    value = static_cast<uint8_t>(constrain(next, 1, maximum));
    setIntervalForCurrentPhase();
    saveSettings();
}

static void handleIntervalExpiry()
{
    if (!intervalRunning || intervalCurrentRemainingUs() > 0) {
        return;
    }
    if (intervalWorkPhase) {
        ++intervalRounds;
    }
    intervalWorkPhase = !intervalWorkPhase;
    setIntervalForCurrentPhase();
    intervalEndsUs =
        monotonicUs() + static_cast<int64_t>(intervalRemainingUs);
    playAlertPulse();
    markActivity();
    updateCurrentView(true);
}

