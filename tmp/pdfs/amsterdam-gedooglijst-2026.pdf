          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:namespaceURI>http://purl.org/dc/terms/</pdfaSchema:namespaceURI>
            <pdfaSchema:prefix>dcterms</pdfaSchema:prefix>
            <pdfaSchema:schema>DC terms</pdfaSchema:schema>
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>DCTERMS.available is de datum van publicatie of bekendmaking. Dit staat los van het medium, dat wil zeggen dat de oude papieren publicaties voor DCTERMS.available de datum van destijds hebben en de nieuwe publicaties op de site de datum van bekendmaking. Anders gezegd binnen OP, bevat DCTERMS.available altijd de datum van OfficiÃ«le bekendmaking. </pdfaProperty:description>
                  <pdfaProperty:name>available</pdfaProperty:name>
                  <pdfaProperty:valueType>Date</pdfaProperty:valueType>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>issued</pdfaProperty:description>
                  <pdfaProperty:name>issued</pdfaProperty:name>
                  <pdfaProperty:valueType>Date</pdfaProperty:valueType>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>Taal van de (intellectuele) inhoud van de bron.</pdfaProperty:description>
                  <pdfaProperty:name>language</pdfaProperty:name>
                  <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>(Overheids)organisatie verantwoordelijk voor het beschikbaar maken van de overheidsbron.</pdfaProperty:description>
                  <pdfaProperty:name>publisher</pdfaProperty:name>
                  <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>type</pdfaProperty:description>
                  <pdfaProperty:name>type</pdfaProperty:name>
